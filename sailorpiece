-- ─── Helpers ─────────────────────────────────────────────────
local function getRootPart(model)
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChildOfClass("BasePart")
end

local function isAlive(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function getTargetPos(tr)
    if farmMethod == "Orbit" then
        orbitAngle = orbitAngle + orbitSpeed
        local ox = math.cos(orbitAngle) * orbitDistance
        local oz = math.sin(orbitAngle) * orbitDistance
        return Vector3.new(tr.Position.X + ox, tr.Position.Y, tr.Position.Z + oz)
    elseif farmMethod == "Above" then
        return Vector3.new(tr.Position.X, tr.Position.Y + verticalDist, tr.Position.Z)
    elseif farmMethod == "Under" then
        return Vector3.new(tr.Position.X, tr.Position.Y - verticalDist, tr.Position.Z)
    end
end

local function farmAttack(hrp, checkFn)
    local folder = game.Workspace:FindFirstChild("NPCs")
    if not folder then return end

    local nearest, bestDist = nil, math.huge
    for _, model in pairs(folder:GetChildren()) do
        if model:IsA("Model") and isAlive(model) and model.Name ~= "TrainingDummy" then
            if skipBoss and string.find(model.Name, "Boss") then continue end
            if onlyBoss and not string.find(model.Name, "Boss") then continue end
            local root = getRootPart(model)
            if root then
                local dx = root.Position.X - hrp.Position.X
                local dy = root.Position.Y - hrp.Position.Y
                local dz = root.Position.Z - hrp.Position.Z
                local d  = math.sqrt(dx*dx + dy*dy + dz*dz)
                if d < bestDist and d <= 500 then
                    bestDist = d; nearest = model
                end
            end
        end
    end
    if not nearest then return end

    task.spawn(function()
        while checkFn() and isAlive(nearest) do
            for _, part in pairs(nearest:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
            task.wait()
        end
    end)

    local lastClick = 0
    while checkFn() and isAlive(nearest) do
        local tr = getRootPart(nearest)
        if tr then
            local targetPos = getTargetPos(tr)
            hrp.Position = targetPos
            hrp.Velocity = Vector3.new(0, 0, 0)
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.CFrame = CFrame.lookAt(targetPos, tr.Position)
        end
        local now = os.clock()
        if now - lastClick >= 0.06 then mouse1click(); lastClick = now end
        task.wait()
    end
end

