-- ─── Farm Config Helpers ──────────────────────────────────────
local function cfgGetHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function cfgTweenTo(targetPos)
    local hrp = cfgGetHRP()
    if not hrp then return end
    local startPos = hrp.Position
    local dx = targetPos.X - startPos.X
    local dy = targetPos.Y - startPos.Y
    local dz = targetPos.Z - startPos.Z
    local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
    if dist < 0.5 then return end
    local duration = dist / TWEEN_SPEED
    local t0 = os.clock()
    while true do
        if not farmConfig then return end
        local hrp2 = cfgGetHRP()
        if not hrp2 then return end
        local alpha = math.min((os.clock() - t0) / duration, 1)
        hrp2.Position = Vector3.new(
            startPos.X + dx * alpha,
            startPos.Y + dy * alpha,
            startPos.Z + dz * alpha
        )
        hrp2.Velocity = Vector3.new(0, 0, 0)
        hrp2.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        if alpha >= 1 then break end
        task.wait()
    end
end

local function cfgGetClosestPortal()
    local hrp = cfgGetHRP()
    if not hrp then return nil end
    local best, bestDist = nil, math.huge
    for _, obj in pairs(game.Workspace:GetDescendants()) do
        if string.find(obj.Name:lower(), "portal") and obj:IsA("BasePart") then
            local dx = obj.Position.X - hrp.Position.X
            local dy = obj.Position.Y - hrp.Position.Y
            local dz = obj.Position.Z - hrp.Position.Z
            local d = math.sqrt(dx*dx + dy*dy + dz*dz)
            if d < bestDist then bestDist = d; best = obj end
        end
    end
    return best
end

local function cfgTweenToPortal()
    local portal = cfgGetClosestPortal()
    if portal then
        cfgTweenTo(portal.Position)
        task.wait(1)
    end
end

local function cfgGetBoss()
    local folder = game.Workspace:FindFirstChild("NPCs")
    if not folder then return nil end
    return folder:FindFirstChild(BOSS_NAME)
end

local function cfgIsAlive(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function cfgKillBoss()
    local boss = cfgGetBoss()
    if not boss then return end
    local bossRoot = boss:FindFirstChild("HumanoidRootPart") or boss:FindFirstChildOfClass("BasePart")
    if not bossRoot then return end
    notify("Boss found! Killing " .. BOSS_NAME, "Farm Config", 3)
    -- tween to portal first
    cfgTweenToPortal()
    -- tween to boss
    local lastClick = 0
    while farmConfig and cfgIsAlive(boss) do
        local hrp = cfgGetHRP()
        if not hrp then break end
        bossRoot = boss:FindFirstChild("HumanoidRootPart") or boss:FindFirstChildOfClass("BasePart")
        if not bossRoot then break end
        -- disable boss collision
        for _, part in pairs(boss:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        hrp.Position = Vector3.new(bossRoot.Position.X, bossRoot.Position.Y + 10, bossRoot.Position.Z)
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        local now = os.clock()
        if now - lastClick >= 0.06 then mouse1click(); lastClick = now end
        task.wait()
    end
    notify("Boss killed! Returning to farm spot", "Farm Config", 3)
    -- go back: portal -> jojos -> farm spot
    cfgTweenToPortal()
    cfgTweenTo(WP.jojosWP)
    cfgTweenTo(WP.farmSpot)
end

local function cfgKillBandits()
    local folder = game.Workspace:FindFirstChild("NPCs")
    if not folder then return end
    local hrp = cfgGetHRP()
    if not hrp then return end
    -- find alive bandit
    for _, name in pairs(BANDIT_NAMES) do
        if not farmConfig then return end
        local bandit = folder:FindFirstChild(name)
        if bandit and cfgIsAlive(bandit) then
            local bRoot = bandit:FindFirstChild("HumanoidRootPart") or bandit:FindFirstChildOfClass("BasePart")
            if bRoot then
                local lastClick = 0
                while farmConfig and cfgIsAlive(bandit) do
                    hrp = cfgGetHRP()
                    if not hrp then break end
                    bRoot = bandit:FindFirstChild("HumanoidRootPart") or bandit:FindFirstChildOfClass("BasePart")
                    if not bRoot then break end
                    for _, part in pairs(bandit:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                    hrp.Position = Vector3.new(bRoot.Position.X, bRoot.Position.Y + 5, bRoot.Position.Z)
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    local now = os.clock()
                    if now - lastClick >= 0.06 then mouse1click(); lastClick = now end
                    task.wait()
                end
            end
        end
    end
end

-- ─── Farm Config Loop ─────────────────────────────────────────
task.spawn(function()
    local lastBossCheck = os.clock()
    while true do
        task.wait()
        if not farmConfig then continue end

        local now = os.clock()

        -- every 15 mins check punch island for boss
        if now - lastBossCheck >= 900 then
            lastBossCheck = now
            notify("Checking Punch Island for boss...", "Farm Config", 2)
            cfgTweenToPortal()
            cfgTweenTo(WP.punchWP)
            task.wait(2)
            if cfgGetBoss() and cfgIsAlive(cfgGetBoss()) then
                cfgKillBoss()
            else
                notify("No boss found, returning to farm", "Farm Config", 2)
                cfgTweenToPortal()
                cfgTweenTo(WP.jojosWP)
                cfgTweenTo(WP.farmSpot)
            end
            continue
        end

        -- check if boss just spawned nearby
        local boss = cfgGetBoss()
        if boss and cfgIsAlive(boss) then
            lastBossCheck = now -- reset timer after killing
            cfgKillBoss()
            continue
        end

        -- make sure we're near farm spot
        local hrp = cfgGetHRP()
        if hrp then
            local dx = hrp.Position.X - WP.farmSpot.X
            local dz = hrp.Position.Z - WP.farmSpot.Z
            if math.sqrt(dx*dx + dz*dz) > 100 then
                cfgTweenTo(WP.farmSpot)
            end
        end

        -- farm bandits
        cfgKillBandits()
    end
end)

