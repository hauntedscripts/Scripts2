-- UE / Linoria-style UI compatibility port for Matcha LuaVM
-- Drawing-based: no Instance.new, ScreenGui, UDim2, Enum, RunService, or TweenService.

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
    repeat
        wait(0.1)
        LocalPlayer = Players.LocalPlayer
    until LocalPlayer
end

local Mouse = LocalPlayer:GetMouse()
local Environment = (type(getgenv) == "function" and getgenv()) or _G

-- Stop an older copy before creating new Drawing objects. Re-executing the
-- library without this leaves two render loops fighting over the same screen.
local PreviousLibrary = Environment.UELibrary
if PreviousLibrary and type(PreviousLibrary.Unload) == "function" then
    pcall(function() PreviousLibrary:Unload() end)
end

local Toggles = Environment.Toggles or {}
local Options = Environment.Options or {}
Environment.Toggles = Toggles
Environment.Options = Options

local function clamp(value, minimum, maximum)
    if value < minimum then return minimum end
    if value > maximum then return maximum end
    return value
end

local function round(value, places)
    local power = 10 ^ (places or 0)
    return math.floor(value * power + 0.5) / power
end

local UI_SCALE = 0.92
local TEXT_Y_OFFSET = 4
local TAB_TEXT_Y_OFFSET = 5

local function ui(value)
    return math.max(1, math.floor(value * UI_SCALE + 0.5))
end

local function rgbToHsv(color)
    local r, g, b = color.R, color.G, color.B
    local maximum = math.max(r, g, b)
    local minimum = math.min(r, g, b)
    local delta = maximum - minimum
    local hue = 0

    if delta > 0 then
        if maximum == r then
            hue = ((g - b) / delta) % 6
        elseif maximum == g then
            hue = ((b - r) / delta) + 2
        else
            hue = ((r - g) / delta) + 4
        end
        hue = hue / 6
    end

    local saturation = maximum == 0 and 0 or delta / maximum
    return hue, saturation, maximum
end

local function hsvToRgb(hue, saturation, value)
    hue = (hue or 0) % 1
    saturation = clamp(saturation or 0, 0, 1)
    value = clamp(value or 0, 0, 1)
    local section = math.floor(hue * 6)
    local fraction = hue * 6 - section
    local p = value * (1 - saturation)
    local q = value * (1 - fraction * saturation)
    local t = value * (1 - (1 - fraction) * saturation)
    section = section % 6
    if section == 0 then return Color3.new(value, t, p) end
    if section == 1 then return Color3.new(q, value, p) end
    if section == 2 then return Color3.new(p, value, t) end
    if section == 3 then return Color3.new(p, q, value) end
    if section == 4 then return Color3.new(t, p, value) end
    return Color3.new(value, p, q)
end

local function inside(point, rect)
    return rect and point.X >= rect.x and point.X <= rect.x + rect.w
        and point.Y >= rect.y and point.Y <= rect.y + rect.h
end

local function safeCallback(callback, ...)
    if type(callback) ~= "function" then return end
    local ok, err = pcall(callback, ...)
    if not ok then warn("UE Matcha callback error: " .. tostring(err)) end
end

local function copyTable(source)
    local output = {}
    for key, value in pairs(source or {}) do output[key] = value end
    return output
end

local function keyName(code)
    if code == nil then return "None" end
    if type(code) == "string" then return code end
    if code == 0x01 then return "MB1" end
    if code == 0x02 then return "MB2" end
    if code >= 0x30 and code <= 0x39 then return string.char(code) end
    if code >= 0x41 and code <= 0x5A then return string.char(code) end
    if code >= 0x70 and code <= 0x7B then return "F" .. tostring(code - 0x6F) end
    local names = {
        [0x08] = "Backspace", [0x09] = "Tab", [0x0D] = "Enter",
        [0x10] = "Shift", [0x11] = "Ctrl", [0x12] = "Alt",
        [0x1B] = "Escape", [0x20] = "Space", [0x23] = "End",
        [0x24] = "Home", [0x25] = "Left", [0x26] = "Up",
        [0x27] = "Right", [0x28] = "Down", [0x2D] = "Insert",
        [0x2E] = "Delete"
    }
    return names[code] or ("0x" .. string.format("%02X", code))
end

local function keyCode(value)
    if type(value) == "number" then return value end
    if type(value) ~= "string" then return nil end
    local upper = string.upper(value)
    if upper == "MB1" then return 0x01 end
    if upper == "MB2" then return 0x02 end
    if #upper == 1 then return string.byte(upper) end
    local functionNumber = tonumber(string.match(upper, "^F(%d+)$"))
    if functionNumber and functionNumber >= 1 and functionNumber <= 12 then
        return 0x6F + functionNumber
    end
    local names = {
        NONE = nil, BACKSPACE = 0x08, TAB = 0x09, ENTER = 0x0D,
        SHIFT = 0x10, CTRL = 0x11, ALT = 0x12, ESCAPE = 0x1B,
        SPACE = 0x20, END = 0x23, HOME = 0x24, LEFT = 0x25,
        UP = 0x26, RIGHT = 0x27, DOWN = 0x28, INSERT = 0x2D,
        DELETE = 0x2E
    }
    return names[upper]
end

