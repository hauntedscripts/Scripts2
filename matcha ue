    local group = setmetatable({
        Name = info.Name or "Groupbox", Side = info.Side == 2 and 2 or 1,
        Controls = {}, Window = self.Window, Tab = self, Type = "Groupbox"
    }, GroupMethods)
    table.insert(self.Groups, group)
    self.Groupboxes[group.Name] = group
