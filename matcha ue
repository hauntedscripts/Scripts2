Library.Toggles = Toggles
Library.Options = Options

local function drawing(drawType, properties, owner)
    local object = Drawing.new(drawType)
    for key, value in pairs(properties or {}) do object[key] = value end
    object.Visible = false
    table.insert(Library._drawings, object)
    local initialColor = properties and properties.Color
    if initialColor and math.abs(initialColor.R - Library.AccentColor.R) < 0.0001
        and math.abs(initialColor.G - Library.AccentColor.G) < 0.0001
        and math.abs(initialColor.B - Library.AccentColor.B) < 0.0001 then
        table.insert(Library._accentDrawings, object)
    end
    if owner then table.insert(owner._drawings, object) end
    return object
end

local function hideDeep(value)
    if value == nil then return end
    if type(value) == "table" then
        for _, child in pairs(value) do hideDeep(child) end
    else
        pcall(function() value.Visible = false end)
    end
end

local function removeDrawing(object)
    if not object then return end
    pcall(function() object:Remove() end)
end

function Library:SafeCallback(callback, ...)
    safeCallback(callback, ...)
end

function Library:Notify(text, time)
    notify(tostring(text or ""), "UE Matcha", time or 3)
end

function Library:SetFontSize(size)
    if type(size) == "number" and size > 0 then self.FontSize = size end
end

function Library:SetAccentColor(color)
    if not color then return end
    self.AccentColor = color
    for _, object in ipairs(self._accentDrawings) do
        pcall(function() object.Color = color end)
    end
end

function Library:GetDarkerColor(color)
    return Color3.new(color.R * 0.75, color.G * 0.75, color.B * 0.75)
end

function Library:MapValue(value, minA, maxA, minB, maxB)
    return (1 - ((value - minA) / (maxA - minA))) * minB + ((value - minA) / (maxA - minA)) * maxB
end

function Library:AttemptSave()
    if self.SaveManager and type(self.SaveManager.Save) == "function" then
        safeCallback(function() self.SaveManager:Save() end)
    end
end

function Library:OnUnload(callback)
    table.insert(self.UnloadCallbacks, callback)
end

function Library:UpdateBlur() end
function Library:UpdateColorsUsingRegistry() end
function Library:SetWatermarkVisibility() end
function Library:SetKeybindVisibility() end
function Library:SetWatermark() end

