    info.Transparency = info.Transparency or 0
    return self.Group:_addColorPicker(id, info, self)
end

function ControlMethods:AddButton(...)
    if not self.Group then return nil end
    return self.Group:AddButton(...)
end

local function register(group, control)
    control.Group = group
    control.Window = group.Window
    control.Visible = control.Visible ~= false
    setmetatable(control, ControlMethods)
    table.insert(group.Controls, control)
    return control
end

function GroupMethods:_new(typeName, data)
    data = data or {}
    data.Type = typeName
    return register(self, data)
end

function GroupMethods:AddBlank(size)
    self:_new("Blank", { Height = size or 5 })
    return self
end

function GroupMethods:AddLabel(text, wraps)
    return self:_new("Label", { Text = tostring(text or ""), Wrap = wraps == true, Height = wraps and 32 or 18 })
end

function GroupMethods:AddDivider()
    return self:_new("Divider", { Height = 10 })
end

function GroupMethods:AddButton(...)
    local first = select(1, ...)
    local data = {}
    if type(first) == "table" then
        data.Text = first.Text or "Button"
        data.Callback = first.Func or first.Callback
        data.DoubleClick = first.DoubleClick == true
        data.Tooltip = first.Tooltip
    else
        data.Text = tostring(first or "Button")
        data.Callback = select(2, ...)
    end
    return self:_new("Button", data)
end

function GroupMethods:AddToggle(id, info)
    info = info or {}
    local control = self:_new("Toggle", {
        Id = id, Text = info.Text or id, Value = info.Default == true,
        Callback = info.Callback, Risky = info.Risky == true, Tooltip = info.Tooltip
    })
    Toggles[id] = control
    return control
end

function GroupMethods:AddSlider(id, info)
    info = info or {}
    local control = self:_new("Slider", {
        Id = id, Text = info.Text or id, Min = info.Min or 0, Max = info.Max or 100,
        Rounding = info.Rounding or 0, Compact = info.Compact == true,
        Suffix = info.Suffix or "", Callback = info.Callback,
        Value = info.Default ~= nil and info.Default or (info.Min or 0), Tooltip = info.Tooltip
    })
    control.Value = clamp(round(control.Value, control.Rounding), control.Min, control.Max)
    Options[id] = control
    return control
end

function GroupMethods:AddDropdown(id, info)
    info = info or {}
    local control = self:_new("Dropdown", {
        Id = id, Text = info.Text or id, Values = info.Values or {}, Multi = info.Multi == true,
        AllowNull = info.AllowNull == true, Callback = info.Callback,
        Value = info.Multi and (type(info.Default) == "table" and copyTable(info.Default) or {}) or info.Default,
        Tooltip = info.Tooltip, SpecialType = info.SpecialType
    })
    if control.Value == nil and not control.AllowNull and #control.Values > 0 then control.Value = control.Values[1] end
    Options[id] = control
    return control
end

function GroupMethods:AddInput(id, info)
    info = info or {}
    local control = self:_new("Input", {
        Id = id, Text = info.Text or id, Value = tostring(info.Default or ""),
        Numeric = info.Numeric == true, Finished = info.Finished == true,
        Callback = info.Callback, Placeholder = info.Placeholder or "", Tooltip = info.Tooltip
    })
    Options[id] = control
    return control
end

function GroupMethods:_addKeyPicker(id, info, attached)
    local control = self:_new("KeyPicker", {
        Id = id, Text = info.Text or (attached and attached.Text) or id,
        Value = info.Default or "None", Mode = info.Mode or "Toggle",
        Modes = info.Modes or { "Always", "Toggle", "Hold" }, Callback = info.Callback,
        SyncToggleState = info.SyncToggleState == true, NoUI = info.NoUI == true,
        Attached = attached, Inline = attached ~= nil and info.Inline ~= false,
        Tooltip = info.Tooltip, LastState = false
    })
    if attached and control.Inline then attached.InlineKeyPicker = control end
    Options[id] = control
    table.insert(Library.KeyPickerList, control)
    return control
end

function GroupMethods:AddKeyPicker(id, info)
    return self:_addKeyPicker(id, info or {}, nil)
end

-- Wabi-style combined row. The returned toggle and key picker still appear in
-- Toggles[id] / Options[keybindId] and keep all normal Linoria methods.
function GroupMethods:AddToggleWithKeybind(toggleId, keybindId, info)
    info = info or {}
    local toggle = self:AddToggle(toggleId, info)
    local keyInfo = type(info.Keybind) == "table" and copyTable(info.Keybind) or {}
    keyInfo.Text = keyInfo.Text or info.Text or toggleId
    keyInfo.Default = keyInfo.Default or info.DefaultKey or "None"
    keyInfo.Mode = keyInfo.Mode or "Toggle"
    if keyInfo.SyncToggleState == nil then keyInfo.SyncToggleState = true end
    keyInfo.Inline = true
    local picker = toggle:AddKeyPicker(keybindId or (toggleId .. "_key"), keyInfo)
    return toggle, picker
end

function GroupMethods:_addColorPicker(id, info, attached)
    local control = self:_new("ColorPicker", {
        Id = id, Text = info.Title or info.Text or (attached and attached.Text) or id,
        Value = info.Default or Color3.new(1, 1, 1), Transparency = info.Transparency or 0,
        Callback = info.Callback, Attached = attached, Tooltip = info.Tooltip, PaletteIndex = 1
    })
    Options[id] = control
    return control
end

function GroupMethods:AddColorPicker(id, info)
    return self:_addColorPicker(id, info or {}, nil)
end

function GroupMethods:AddColorPickerAlpha(id, info)
