function ControlMethods:SetValue(value)
    if self.Type == "Toggle" then
        self.Value = value == true
    elseif self.Type == "Slider" then
        local numberValue = tonumber(value) or self.Min
        self.Value = clamp(round(numberValue, self.Rounding), self.Min, self.Max)
    elseif self.Type == "Dropdown" then
        if self.Multi then
            self.Value = type(value) == "table" and copyTable(value) or {}
        else
            self.Value = value
        end
    elseif self.Type == "Input" then
        self.Value = tostring(value or "")
    elseif self.Type == "KeyPicker" then
        if type(value) == "table" then
            self.Value = value[1] or value.Value or self.Value
            self.Mode = value[2] or value.Mode or self.Mode
        else
            self.Value = value
        end
    elseif self.Type == "ColorPicker" then
        self.Value = value or self.Value
    end

    safeCallback(self.Callback, self.Value)
    safeCallback(self.Changed, self.Value)
    -- Sliders update continuously while dragged; forcing a full visibility
    -- refresh there would bring the flicker back. Dependencies are normally
    -- driven by toggles/dropdowns, so only those invalidate the visible set.
    if self.Window and (self.Type == "Toggle" or self.Type == "Dropdown") then
        self.Window._visibilityDirty = true
    end
    return self
end

function ControlMethods:SetValueRGB(color, transparency)
    if self.Type ~= "ColorPicker" then return self end
    self.Value = color or self.Value
    if transparency ~= nil then self.Transparency = transparency end
    safeCallback(self.Callback, self.Value, self.Transparency)
    safeCallback(self.Changed, self.Value, self.Transparency)
    return self
end

function ControlMethods:SetValues(values)
    if self.Type == "Dropdown" then self.Values = values or {} end
    if self.Window then self.Window._visibilityDirty = true end
    return self
end

function ControlMethods:GetState()
    if self.Type ~= "KeyPicker" then return false end
    local code = keyCode(self.Value)
    if code == 0x01 then return ismouse1pressed() end
    if code == 0x02 then return ismouse2pressed() end
    return code ~= nil and iskeypressed(code)
end

function ControlMethods:GetActiveValues()
    if self.Type ~= "Dropdown" then return {} end
    if not self.Multi then return self.Value ~= nil and { self.Value } or {} end
    local active = {}
    for _, value in ipairs(self.Values or {}) do
        if self.Value[value] == true then table.insert(active, value) end
    end
    return active
end

function ControlMethods:SetKeybindMode(mode)
    if self.Type == "KeyPicker" then self.Mode = mode or self.Mode end
    return self
end

function ControlMethods:GetTransparency()
    return self.Transparency or 0
end

function ControlMethods:OnTransparencyChanged(callback)
    self.TransparencyChanged = callback
    return self
end

function ControlMethods:SetHSVFromRGB(color)
    return self:SetValueRGB(color, self.Transparency)
end

function ControlMethods:GetValueFromXOffset(offset)
    if self.Type ~= "Slider" then return self.Value end
    local percent = clamp(tonumber(offset) or 0, 0, 1)
    return self.Min + (self.Max - self.Min) * percent
end

function ControlMethods:UpdateColors() return self end
function ControlMethods:Update() return self end
function ControlMethods:RefreshKeybinds() return self end
function ControlMethods:Display() return self end
function ControlMethods:BuildDropdownList() return self end
function ControlMethods:CloseDropdown()
    if self.Window and self.Window.OpenDropdown == self then
        self.Window.OpenDropdown = nil
        self.Window._visibilityDirty = true
    end
    return self
end
function ControlMethods:OpenDropdown()
    if self.Window and self.Type == "Dropdown" then
        self.Window.OpenDropdown = self
        self.Window._visibilityDirty = true
    end
    return self
end
function ControlMethods:DoClick()
    if self.Type == "Button" then safeCallback(self.Callback) end
    return self
end

function ControlMethods:AddKeyPicker(id, info)
