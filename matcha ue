function GroupMethods:AddDependencyBox()
    local dependency = self:_new("Dependency", { Controls = {}, Dependencies = {} })
    dependency.Window = self.Window
    dependency.Group = self
    setmetatable(dependency, GroupMethods)
    return dependency
end

function GroupMethods:SetupDependencies(dependencies)
    self.Dependencies = dependencies or {}
    return self
end

function GroupMethods:_dependenciesMet()
    for _, dependency in pairs(self.Dependencies or {}) do
        local option = dependency[1]
        local expected = dependency[2]
        if not option or option.Value ~= expected then return false end
    end
    return true
end

function GroupMethods:AddRow(columns)
    local results = {}
    for i = 1, math.max(1, tonumber(columns) or 2) do results[i] = self end
    return unpack(results)
end

function GroupMethods:Resize() return self end

