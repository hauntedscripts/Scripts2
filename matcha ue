function TabboxMethods:AddTab(name)
    local page = setmetatable({
        Name = name, Controls = {}, Window = self.Window, Tabbox = self,
        Type = "TabboxPage", Dependencies = {}
    }, GroupMethods)
    self.Tabs[name] = page
    table.insert(self.TabList, page)
    if not self.Active then self.Active = page end
    function page:Show()
        self.Tabbox.Active = self
        self.Window.OpenDropdown = nil
        self.Window._visibilityDirty = true
        return self
    end
    function page:Hide() return self end
    return page
end

local function controlHeight(control)
    if control.Visible == false then return 0 end
    if control.Type == "KeyPicker" and control.Inline then return 0 end
    if control.Type == "Dependency" then
        if not control:_dependenciesMet() then return 0 end
        local total = 0
        for _, child in ipairs(control.Controls) do total = total + controlHeight(child) end
        return total
    end
    if control.Type == "Blank" then return ui(control.Height or 5) end
    if control.Type == "Label" then return ui(control.Height or 18) end
    if control.Type == "Divider" then return ui(10) end
    if control.Type == "Button" then return ui(24) end
    if control.Type == "Toggle" then return ui(20) end
    if control.Type == "Slider" then return ui(40) end
    if control.Type == "Dropdown" then return ui(40) end
    if control.Type == "Input" then return ui(40) end
    if control.Type == "KeyPicker" or control.Type == "ColorPicker" then return ui(22) end
    return ui(20)
end

local function controlsHeight(controls)
    local total = 0
    for _, control in ipairs(controls or {}) do total = total + controlHeight(control) end
    return total
end

local function displayDropdown(control)
    if control.Multi then
        local selected = {}
        for _, value in ipairs(control.Values) do
            if control.Value[value] == true then table.insert(selected, tostring(value)) end
        end
        return #selected > 0 and table.concat(selected, ", ") or "None"
    end
    return control.Value ~= nil and tostring(control.Value) or "None"
end

function WindowMethods:_draw(drawType, properties)
    return drawing(drawType, properties, self)
end

function WindowMethods:_ensureFrame()
    if self.Frame then return end
    self.Frame = {
        Background = self:_draw("Square", { Filled = true, Color = Library.BackgroundColor, ZIndex = 1 }),
        Header = self:_draw("Square", { Filled = true, Color = Library.MainColor, ZIndex = 2 }),
        Border = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.Black, ZIndex = 5 }),
        InnerBorder = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.OutlineColor, ZIndex = 4 }),
        Accent = self:_draw("Square", { Filled = true, Color = Library.AccentColor, ZIndex = 6 }),
        Title = self:_draw("Text", { Text = self.Title, Color = Library.FontColor, Size = Library.FontSize, Outline = true, ZIndex = 7 }),
        TabLine = self:_draw("Line", { Thickness = 1, Color = Library.OutlineColor, ZIndex = 4 })
    }
end

function WindowMethods:_ensureTabPack(tab)
    if tab._pack then return tab._pack end
    tab._pack = {
        Background = self:_draw("Square", { Filled = true, Color = Library.BackgroundColor, ZIndex = 3 }),
        Text = self:_draw("Text", { Text = tab.Name, Color = Library.FontColor, Size = Library.FontSize, Outline = true, Center = true, ZIndex = 7 }),
        Accent = self:_draw("Square", { Filled = true, Color = Library.AccentColor, ZIndex = 8 })
    }
    return tab._pack
end

function WindowMethods:_ensureGroupPack(group)
    if group._pack then return group._pack end
    group._pack = {
        Background = self:_draw("Square", { Filled = true, Color = Library.BackgroundColor, ZIndex = 2 }),
        Border = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.OutlineColor, ZIndex = 4 }),
        Inner = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.Black, ZIndex = 3 }),
        Accent = self:_draw("Square", { Filled = true, Color = Library.AccentColor, ZIndex = 5 }),
        Title = self:_draw("Text", { Text = group.Name or "", Color = Library.FontColor, Size = Library.FontSize, Outline = true, ZIndex = 6 })
    }
    return group._pack
end

function WindowMethods:_ensureControlPack(control)
    if control._pack then return control._pack end
    local pack = {}

    if control.Type == "Label" then
        pack.Text = self:_draw("Text", { Color = Library.FontColor, Size = Library.FontSize, Outline = true, ZIndex = 8 })
    elseif control.Type == "Divider" then
        pack.Line = self:_draw("Line", { Thickness = 1, Color = Library.OutlineColor, ZIndex = 7 })
    elseif control.Type == "Button" then
        pack.Background = self:_draw("Square", { Filled = true, Color = Library.MainColor, ZIndex = 7 })
        pack.Border = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.Black, ZIndex = 8 })
        pack.InnerBorder = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.OutlineColor, ZIndex = 9 })
        pack.Text = self:_draw("Text", { Color = Library.FontColor, Size = Library.FontSize, Outline = true, Center = true, ZIndex = 10 })
    elseif control.Type == "Toggle" then
        pack.Outer = self:_draw("Square", { Filled = true, Color = Library.Black, ZIndex = 7 })
        pack.Inner = self:_draw("Square", { Filled = true, Color = Library.MainColor, ZIndex = 8 })
        pack.Fill = self:_draw("Square", { Filled = true, Color = Library.AccentColor, ZIndex = 9 })
        pack.Text = self:_draw("Text", { Color = Library.FontColor, Size = Library.FontSize, Outline = true, ZIndex = 9 })
    elseif control.Type == "Slider" then
        pack.Text = self:_draw("Text", { Color = Library.FontColor, Size = Library.FontSize, Outline = true, ZIndex = 8 })
        pack.Value = self:_draw("Text", { Color = Library.FontColor, Size = Library.FontSize, Outline = true, Center = true, ZIndex = 8 })
        pack.Bar = self:_draw("Square", { Filled = true, Color = Library.MainColor, ZIndex = 7 })
        pack.Border = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.OutlineColor, ZIndex = 8 })
        pack.Fill = self:_draw("Square", { Filled = true, Color = Library.AccentColor, ZIndex = 9 })
    elseif control.Type == "Dropdown" or control.Type == "Input" or control.Type == "KeyPicker" then
        pack.Text = self:_draw("Text", { Color = Library.FontColor, Size = Library.FontSize, Outline = true, ZIndex = 8 })
        pack.Box = self:_draw("Square", { Filled = true, Color = Library.MainColor, ZIndex = 7 })
        pack.Border = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.OutlineColor, ZIndex = 8 })
        pack.Value = self:_draw("Text", { Color = Library.FontColor, Size = Library.FontSize, Outline = true, Center = true, ZIndex = 9 })
    elseif control.Type == "ColorPicker" then
        pack.Text = self:_draw("Text", { Color = Library.FontColor, Size = Library.FontSize, Outline = true, ZIndex = 8 })
        pack.Swatch = self:_draw("Square", { Filled = true, Color = control.Value, ZIndex = 8 })
        pack.Border = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.Black, ZIndex = 9 })
    end

    control._pack = pack
    return pack
end

function WindowMethods:_renderControl(control, x, y, width, activeList)
    if control.Visible == false then return y end
    -- Attached key pickers are drawn by their toggle so both controls share
    -- one row. They are still added to the active list there for mouse input.
    if control.Type == "KeyPicker" and control.Inline then return y end
    if control.Type == "Dependency" then
        if not control:_dependenciesMet() then return y end
        for _, child in ipairs(control.Controls) do
            y = self:_renderControl(child, x, y, width, activeList)
        end
        return y
    end

    local height = controlHeight(control)
    if height <= 0 then return y end
    control._rect = { x = x, y = y, w = width, h = height }
    table.insert(activeList, control)

    if control.Type == "Blank" then return y + height end

    local pack = self:_ensureControlPack(control)
    if control.Type == "Label" then
        pack.Text.Text = control.Text or ""
        pack.Text.Position = Vector2.new(x, y + 1 + TEXT_Y_OFFSET)
        pack.Text.Visible = true

    elseif control.Type == "Divider" then
        pack.Line.From = Vector2.new(x, y + ui(4))
        pack.Line.To = Vector2.new(x + width, y + ui(4))
        pack.Line.Visible = true

    elseif control.Type == "Button" then
        local hovered = inside(self.MousePosition, control._rect)
        pack.Background.Position = Vector2.new(x, y + ui(2))
        pack.Background.Size = Vector2.new(width, ui(20))
        pack.Background.Color = Library.MainColor
        pack.Background.Visible = true
        pack.Border.Position = Vector2.new(x, y + ui(2))
        pack.Border.Size = Vector2.new(width, ui(20))
        pack.Border.Color = hovered and Library.AccentColor or Library.Black
        pack.Border.Visible = true
        pack.InnerBorder.Position = Vector2.new(x + 1, y + ui(3))
        pack.InnerBorder.Size = Vector2.new(width - 2, ui(18))
        pack.InnerBorder.Visible = true
        pack.Text.Text = control.Text or "Button"
        pack.Text.Position = Vector2.new(x + width / 2, y + ui(7) + TEXT_Y_OFFSET)
        pack.Text.Visible = true

    elseif control.Type == "Toggle" then
        local boxY = y + ui(3)
        pack.Outer.Position = Vector2.new(x, boxY)
        pack.Outer.Size = Vector2.new(ui(14), ui(14))
        pack.Outer.Visible = true
        pack.Inner.Position = Vector2.new(x + 1, boxY + 1)
        pack.Inner.Size = Vector2.new(ui(12), ui(12))
        pack.Inner.Visible = true
        pack.Fill.Position = Vector2.new(x + ui(3), boxY + ui(3))
        pack.Fill.Size = Vector2.new(ui(8), ui(8))
        pack.Fill.Color = control.Risky and Library.RiskColor or Library.AccentColor
        pack.Fill.Visible = control.Value == true
        pack.Text.Text = control.Text or control.Id
        pack.Text.Color = control.Risky and Library.RiskColor or Library.FontColor
        pack.Text.Position = Vector2.new(x + ui(20), y + ui(2) + TEXT_Y_OFFSET)
        pack.Text.Visible = true

        local picker = control.InlineKeyPicker
        if picker and picker.Visible ~= false and not picker.NoUI then
            local pickerPack = self:_ensureControlPack(picker)
            local boxW = ui(70)
            local boxX = x + width - boxW
            local pickerRect = { x = boxX, y = y + 1, w = boxW, h = ui(18) }

            -- Do not let the toggle's click area cover the keybind box.
            control._rect.w = math.max(ui(18), boxX - x - ui(4))
            picker._rect = pickerRect
            picker._boxRect = pickerRect
            table.insert(activeList, picker)

            pickerPack.Text.Visible = false
            pickerPack.Box.Position = Vector2.new(boxX, y + 1)
            pickerPack.Box.Size = Vector2.new(boxW, ui(18))
            pickerPack.Box.Visible = true
            pickerPack.Border.Position = Vector2.new(boxX, y + 1)
            pickerPack.Border.Size = Vector2.new(boxW, ui(18))
            pickerPack.Border.Color = self.CaptureKey == picker and Library.AccentColor or Library.OutlineColor
            pickerPack.Border.Visible = true
            pickerPack.Value.Text = self.CaptureKey == picker and "[...]" or ("[" .. keyName(picker.Value) .. "]")
            pickerPack.Value.Position = Vector2.new(boxX + boxW / 2, y + ui(5) + TEXT_Y_OFFSET)
            pickerPack.Value.Visible = true
        end

    elseif control.Type == "Slider" then
        local percent = (control.Value - control.Min) / math.max(0.0001, control.Max - control.Min)
        pack.Text.Text = control.Text or control.Id
        pack.Text.Position = Vector2.new(x, y + TEXT_Y_OFFSET)
        pack.Text.Visible = true
        pack.Value.Text = tostring(control.Value) .. tostring(control.Suffix or "")
        pack.Value.Position = Vector2.new(x + width - 30, y + 1 + TEXT_Y_OFFSET)
        pack.Value.Visible = true
        pack.Bar.Position = Vector2.new(x, y + ui(20))
        pack.Bar.Size = Vector2.new(width, ui(13))
        pack.Bar.Visible = true
        pack.Border.Position = Vector2.new(x, y + ui(20))
        pack.Border.Size = Vector2.new(width, ui(13))
        pack.Border.Visible = true
        pack.Fill.Position = Vector2.new(x + 1, y + ui(21))
        pack.Fill.Size = Vector2.new(math.max(0, (width - 2) * percent), ui(11))
        pack.Fill.Visible = true
        control._barRect = { x = x, y = y + ui(20), w = width, h = ui(13) }

    elseif control.Type == "Dropdown" or control.Type == "Input" then
        pack.Text.Text = control.Text or control.Id
        pack.Text.Position = Vector2.new(x, y + TEXT_Y_OFFSET)
        pack.Text.Visible = true
        pack.Box.Position = Vector2.new(x, y + ui(17))
        pack.Box.Size = Vector2.new(width, ui(19))
        pack.Box.Visible = true
        pack.Border.Position = Vector2.new(x, y + ui(17))
        pack.Border.Size = Vector2.new(width, ui(19))
        pack.Border.Color = self.CaptureInput == control and Library.AccentColor or Library.OutlineColor
        pack.Border.Visible = true
        local text
        if control.Type == "Dropdown" then
            text = displayDropdown(control)
        else
            text = control.Value ~= "" and control.Value or control.Placeholder
            if self.CaptureInput == control then text = text .. "_" end
        end
        pack.Value.Text = text
        pack.Value.Position = Vector2.new(x + width / 2, y + ui(21) + TEXT_Y_OFFSET)
        pack.Value.Visible = true
        control._boxRect = { x = x, y = y + ui(17), w = width, h = ui(19) }

    elseif control.Type == "KeyPicker" then
        pack.Text.Text = control.Text or control.Id
        pack.Text.Position = Vector2.new(x, y + 2 + TEXT_Y_OFFSET)
        pack.Text.Visible = not control.NoUI
        local boxW = ui(80)
        local boxX = x + width - boxW
        pack.Box.Position = Vector2.new(boxX, y + 1)
        pack.Box.Size = Vector2.new(boxW, ui(18))
        pack.Box.Visible = not control.NoUI
        pack.Border.Position = Vector2.new(boxX, y + 1)
        pack.Border.Size = Vector2.new(boxW, ui(18))
        pack.Border.Color = self.CaptureKey == control and Library.AccentColor or Library.OutlineColor
        pack.Border.Visible = not control.NoUI
        pack.Value.Text = self.CaptureKey == control and "[...]" or ("[" .. keyName(control.Value) .. "]")
        pack.Value.Position = Vector2.new(boxX + boxW / 2, y + 5 + TEXT_Y_OFFSET)
        pack.Value.Visible = not control.NoUI
        control._boxRect = { x = boxX, y = y + 1, w = boxW, h = ui(18) }

    elseif control.Type == "ColorPicker" then
        pack.Text.Text = control.Text or control.Id
        pack.Text.Position = Vector2.new(x, y + 2 + TEXT_Y_OFFSET)
        pack.Text.Visible = true
        pack.Swatch.Position = Vector2.new(x + width - ui(38), y + ui(2))
        pack.Swatch.Size = Vector2.new(ui(38), ui(16))
        pack.Swatch.Color = control.Value
        pack.Swatch.Visible = true
        pack.Border.Position = Vector2.new(x + width - ui(38), y + ui(2))
        pack.Border.Size = Vector2.new(ui(38), ui(16))
        pack.Border.Visible = true
        control._boxRect = { x = x + width - ui(38), y = y + ui(2), w = ui(38), h = ui(16) }
    end

    return y + height
end

function WindowMethods:_renderGroup(group, x, y, width, activeList)
    local pack = self:_ensureGroupPack(group)
    local height = ui(26) + controlsHeight(group.Controls)
    group._rect = { x = x, y = y, w = width, h = height }

    pack.Background.Position = Vector2.new(x, y)
    pack.Background.Size = Vector2.new(width, height)
    pack.Background.Visible = true
    pack.Border.Position = Vector2.new(x, y)
    pack.Border.Size = Vector2.new(width, height)
    pack.Border.Visible = true
    pack.Inner.Position = Vector2.new(x + 1, y + 1)
    pack.Inner.Size = Vector2.new(width - 2, height - 2)
    pack.Inner.Visible = true
    pack.Accent.Position = Vector2.new(x + 1, y + 1)
    pack.Accent.Size = Vector2.new(width - 2, 2)
    pack.Accent.Visible = true
    pack.Title.Text = group.Name or ""
    pack.Title.Position = Vector2.new(x + ui(6), y + ui(5) + TEXT_Y_OFFSET)
    pack.Title.Visible = true

    local controlY = y + ui(23)
    for _, control in ipairs(group.Controls) do
        controlY = self:_renderControl(control, x + ui(7), controlY, width - ui(14), activeList)
    end
    return height
end

function WindowMethods:_ensureTabboxPack(tabbox)
    if tabbox._pack then return tabbox._pack end
    tabbox._pack = {
        Background = self:_draw("Square", { Filled = true, Color = Library.BackgroundColor, ZIndex = 2 }),
        Border = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.OutlineColor, ZIndex = 4 })
    }
    return tabbox._pack
end

function WindowMethods:_renderTabbox(tabbox, x, y, width, activeList)
    local pack = self:_ensureTabboxPack(tabbox)
    local active = tabbox.Active
    local height = ui(25) + (active and controlsHeight(active.Controls) or 0)
    tabbox._rect = { x = x, y = y, w = width, h = height }
    pack.Background.Position = Vector2.new(x, y)
    pack.Background.Size = Vector2.new(width, height)
    pack.Background.Visible = true
    pack.Border.Position = Vector2.new(x, y)
    pack.Border.Size = Vector2.new(width, height)
    pack.Border.Visible = true

    local count = #tabbox.TabList
    if count > 0 then
        local tabWidth = width / count
        for index, page in ipairs(tabbox.TabList) do
            if not page._tabPack then
                page._tabPack = {
                    Background = self:_draw("Square", { Filled = true, Color = Library.MainColor, ZIndex = 5 }),
                    Text = self:_draw("Text", { Color = Library.FontColor, Size = Library.FontSize, Outline = true, Center = true, ZIndex = 7 }),
                    Accent = self:_draw("Square", { Filled = true, Color = Library.AccentColor, ZIndex = 8 })
                }
            end
            local px = x + (index - 1) * tabWidth
            page._tabRect = { x = px, y = y, w = tabWidth, h = ui(20) }
            page._tabPack.Background.Position = Vector2.new(px, y)
            page._tabPack.Background.Size = Vector2.new(tabWidth, ui(20))
            page._tabPack.Background.Color = page == active and Library.BackgroundColor or Library.MainColor
            page._tabPack.Background.Visible = true
            page._tabPack.Text.Text = page.Name
            page._tabPack.Text.Position = Vector2.new(px + tabWidth / 2, y + ui(5) + TEXT_Y_OFFSET)
            page._tabPack.Text.Visible = true
            page._tabPack.Accent.Position = Vector2.new(px, y)
            page._tabPack.Accent.Size = Vector2.new(tabWidth, 2)
            page._tabPack.Accent.Visible = page == active
        end
    end

    if active then
        local controlY = y + ui(23)
        for _, control in ipairs(active.Controls) do
            controlY = self:_renderControl(control, x + ui(7), controlY, width - ui(14), activeList)
        end
    end
    return height
end

function WindowMethods:_renderDropdownOverlay(control)
    if not control or not control._boxRect then return end
    if not control._listPack then
        control._listPack = {
            Background = self:_draw("Square", { Filled = true, Color = Library.BackgroundColor, ZIndex = 30 }),
            Border = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.OutlineColor, ZIndex = 31 }),
            Items = {}
        }
    end

    local count = math.min(8, #control.Values)
    local x, y, width = control._boxRect.x, control._boxRect.y + control._boxRect.h + 1, control._boxRect.w
    local itemHeight = ui(20)
    local height = count * itemHeight + 2
    control._listRect = { x = x, y = y, w = width, h = height }
    control._itemRects = {}
    control._listPack.Background.Position = Vector2.new(x, y)
    control._listPack.Background.Size = Vector2.new(width, height)
    control._listPack.Background.Visible = true
    control._listPack.Border.Position = Vector2.new(x, y)
    control._listPack.Border.Size = Vector2.new(width, height)
    control._listPack.Border.Visible = true

    for index = 1, count do
        if not control._listPack.Items[index] then
            control._listPack.Items[index] = {
                Background = self:_draw("Square", { Filled = true, Color = Library.BackgroundColor, ZIndex = 32 }),
                Text = self:_draw("Text", { Color = Library.FontColor, Size = Library.FontSize, Outline = true, ZIndex = 33 })
            }
        end
        local item = control._listPack.Items[index]
        local itemY = y + 1 + (index - 1) * itemHeight
        local value = control.Values[index]
        local selected = control.Multi and control.Value[value] == true or (not control.Multi and control.Value == value)
        control._itemRects[index] = { x = x + 1, y = itemY, w = width - 2, h = itemHeight }
        item.Background.Position = Vector2.new(x + 1, itemY)
        item.Background.Size = Vector2.new(width - 2, itemHeight)
        item.Background.Color = selected and Library.MainColor or Library.BackgroundColor
        item.Background.Visible = true
        item.Text.Text = (selected and "[x] " or "") .. tostring(value)
        item.Text.Color = selected and Library.AccentColor or Library.FontColor
        item.Text.Position = Vector2.new(x + ui(6), itemY + ui(3) + TEXT_Y_OFFSET)
        item.Text.Visible = true
    end
end

local COLOR_PICKER = {
    Width = 250, Height = 236,
    SVWidth = 180, SVHeight = 104,
    SVColumns = 12, SVRows = 8,
    HueSegments = 16
}

function WindowMethods:_ensureColorPickerPack()
    if self._colorPickerPack then return self._colorPickerPack end
    local pack = {
        Background = self:_draw("Square", { Filled = true, Color = Library.BackgroundColor, ZIndex = 40 }),
        Border = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.OutlineColor, ZIndex = 47 }),
        Header = self:_draw("Text", { Text = "COLOR PICKER", Color = Library.FontColor, Size = Library.FontSize, Outline = true, ZIndex = 48 }),
        Hint = self:_draw("Text", { Text = "RGB: click a number, type 0-255, press Enter", Color = Library.FontColor, Size = 12, Outline = true, ZIndex = 48 }),
        Preview = self:_draw("Square", { Filled = true, Color = Color3.new(1, 1, 1), ZIndex = 44 }),
        PreviewBorder = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.Black, ZIndex = 45 }),
        SVCursor = self:_draw("Square", { Filled = false, Thickness = 2, Color = Color3.new(1, 1, 1), ZIndex = 46 }),
        HueCursor = self:_draw("Line", { Thickness = 2, Color = Color3.new(1, 1, 1), ZIndex = 46 }),
        SVCells = {}, HueCells = {}, Rows = {}
    }

    for row = 1, COLOR_PICKER.SVRows do
        for column = 1, COLOR_PICKER.SVColumns do
            table.insert(pack.SVCells, self:_draw("Square", { Filled = true, Color = Color3.new(1, 1, 1), ZIndex = 42 }))
        end
    end
    for index = 1, COLOR_PICKER.HueSegments do
        table.insert(pack.HueCells, self:_draw("Square", { Filled = true, Color = hsvToRgb((index - 1) / COLOR_PICKER.HueSegments, 1, 1), ZIndex = 42 }))
    end
    for _, channel in ipairs({ "R", "G", "B" }) do
        pack.Rows[channel] = {
            Label = self:_draw("Text", { Text = channel, Color = Library.FontColor, Size = Library.FontSize, Outline = true, ZIndex = 45 }),
            Box = self:_draw("Square", { Filled = true, Color = Library.MainColor, ZIndex = 43 }),
            BoxBorder = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.OutlineColor, ZIndex = 45 }),
            Value = self:_draw("Text", { Color = Library.FontColor, Size = Library.FontSize, Outline = true, Center = true, ZIndex = 46 }),
            Bar = self:_draw("Square", { Filled = true, Color = Library.MainColor, ZIndex = 43 }),
            Fill = self:_draw("Square", { Filled = true, Color = Library.AccentColor, ZIndex = 44 }),
            BarBorder = self:_draw("Square", { Filled = false, Thickness = 1, Color = Library.OutlineColor, ZIndex = 45 })
        }
    end
    self._colorPickerPack = pack
    return pack
end

function WindowMethods:_renderColorPickerOverlay(control)
    if not control or not control._boxRect then return end
    local pack = self:_ensureColorPickerPack()
    local viewport = workspace.CurrentCamera.ViewportSize
    local x = control._boxRect.x + control._boxRect.w - COLOR_PICKER.Width
    local y = control._boxRect.y + control._boxRect.h + 3
    if x < 4 then x = 4 end
    if x + COLOR_PICKER.Width > viewport.X - 4 then x = viewport.X - COLOR_PICKER.Width - 4 end
    if y + COLOR_PICKER.Height > viewport.Y - 4 then y = control._boxRect.y - COLOR_PICKER.Height - 3 end
    if y < 4 then y = 4 end

    control._pickerRect = { x = x, y = y, w = COLOR_PICKER.Width, h = COLOR_PICKER.Height }
    local svX, svY = x + 8, y + 25
    local hueX, hueY = svX + COLOR_PICKER.SVWidth + 8, svY
    control._svRect = { x = svX, y = svY, w = COLOR_PICKER.SVWidth, h = COLOR_PICKER.SVHeight }
    control._hueRect = { x = hueX, y = hueY, w = 16, h = COLOR_PICKER.SVHeight }

    local hue, saturation, value = rgbToHsv(control.Value)
    if control._pickerHue ~= nil then hue = control._pickerHue else control._pickerHue = hue end

    local refresh = self._visibilityRefresh or pack.ActiveControl ~= control
    local layoutChanged = pack.LayoutX ~= x or pack.LayoutY ~= y
    local hueChanged = pack.RenderedHue == nil or math.abs(pack.RenderedHue - hue) > 0.0001
    pack.ActiveControl = control
    pack.LayoutX, pack.LayoutY = x, y
    pack.RenderedHue = hue

    if layoutChanged then
        pack.Background.Position = Vector2.new(x, y)
        pack.Background.Size = Vector2.new(COLOR_PICKER.Width, COLOR_PICKER.Height)
        pack.Border.Position = Vector2.new(x, y)
        pack.Border.Size = Vector2.new(COLOR_PICKER.Width, COLOR_PICKER.Height)
        pack.Header.Position = Vector2.new(x + 8, y + 5 + TEXT_Y_OFFSET)
        pack.Hint.Position = Vector2.new(x + 8, y + 213 + TEXT_Y_OFFSET)
    end
    if refresh then
        pack.Background.Visible = true
        pack.Border.Visible = true
        pack.Header.Visible = true
        pack.Hint.Visible = true
    end

    local cellW = COLOR_PICKER.SVWidth / COLOR_PICKER.SVColumns
    local cellH = COLOR_PICKER.SVHeight / COLOR_PICKER.SVRows
    local cellIndex = 1
    for row = 1, COLOR_PICKER.SVRows do
        local cellValue = 1 - ((row - 1) / math.max(1, COLOR_PICKER.SVRows - 1))
        for column = 1, COLOR_PICKER.SVColumns do
            local cellSaturation = (column - 1) / math.max(1, COLOR_PICKER.SVColumns - 1)
            local cell = pack.SVCells[cellIndex]
            if layoutChanged then
                cell.Position = Vector2.new(svX + (column - 1) * cellW, svY + (row - 1) * cellH)
                cell.Size = Vector2.new(cellW + 1, cellH + 1)
            end
            if hueChanged then cell.Color = hsvToRgb(hue, cellSaturation, cellValue) end
            if refresh then cell.Visible = true end
            cellIndex = cellIndex + 1
        end
    end

    local hueCellH = COLOR_PICKER.SVHeight / COLOR_PICKER.HueSegments
    for index, cell in ipairs(pack.HueCells) do
        if layoutChanged then
            cell.Position = Vector2.new(hueX, hueY + (index - 1) * hueCellH)
            cell.Size = Vector2.new(16, hueCellH + 1)
        end
        if refresh then cell.Visible = true end
    end

    local cursorX = svX + saturation * COLOR_PICKER.SVWidth
    local cursorY = svY + (1 - value) * COLOR_PICKER.SVHeight
    pack.SVCursor.Position = Vector2.new(cursorX - 3, cursorY - 3)
    pack.SVCursor.Size = Vector2.new(6, 6)
    if refresh then pack.SVCursor.Visible = true end
    local hueYPosition = hueY + hue * COLOR_PICKER.SVHeight
    pack.HueCursor.From = Vector2.new(hueX - 2, hueYPosition)
    pack.HueCursor.To = Vector2.new(hueX + 18, hueYPosition)
    if refresh then pack.HueCursor.Visible = true end

    if layoutChanged then
        pack.Preview.Position = Vector2.new(x + 222, y + 25)
        pack.Preview.Size = Vector2.new(20, 20)
        pack.PreviewBorder.Position = Vector2.new(x + 222, y + 25)
        pack.PreviewBorder.Size = Vector2.new(20, 20)
    end
    pack.Preview.Color = control.Value
    if refresh then
        pack.Preview.Visible = true
        pack.PreviewBorder.Visible = true
    end

    local values = {
        R = math.floor(control.Value.R * 255 + 0.5),
        G = math.floor(control.Value.G * 255 + 0.5),
        B = math.floor(control.Value.B * 255 + 0.5)
    }
    control._rgbRects = {}
    local channels = { "R", "G", "B" }
    for index, channel in ipairs(channels) do
        local rowY = y + 140 + (index - 1) * 24
        local row = pack.Rows[channel]
        local boxRect = { x = x + 25, y = rowY, w = 52, h = 18 }
        local barRect = { x = x + 87, y = rowY + 3, w = 155, h = 12 }
        control._rgbRects[channel] = { Box = boxRect, Bar = barRect }
        if layoutChanged then
            row.Label.Position = Vector2.new(x + 8, rowY + 2 + TEXT_Y_OFFSET)
            row.Box.Position = Vector2.new(boxRect.x, boxRect.y)
            row.Box.Size = Vector2.new(boxRect.w, boxRect.h)
            row.BoxBorder.Position = Vector2.new(boxRect.x, boxRect.y)
            row.BoxBorder.Size = Vector2.new(boxRect.w, boxRect.h)
            row.Value.Position = Vector2.new(boxRect.x + boxRect.w / 2, boxRect.y + 4 + TEXT_Y_OFFSET)
            row.Bar.Position = Vector2.new(barRect.x, barRect.y)
            row.Bar.Size = Vector2.new(barRect.w, barRect.h)
            row.Fill.Position = Vector2.new(barRect.x + 1, barRect.y + 1)
            row.BarBorder.Position = Vector2.new(barRect.x, barRect.y)
            row.BarBorder.Size = Vector2.new(barRect.w, barRect.h)
        end
        row.BoxBorder.Color = self.ColorInput and self.ColorInput.Control == control and self.ColorInput.Channel == channel and Library.AccentColor or Library.OutlineColor
        local displayValue = tostring(values[channel])
        if self.ColorInput and self.ColorInput.Control == control and self.ColorInput.Channel == channel then
            displayValue = self.ColorInput.Buffer .. "_"
        end
        row.Value.Text = displayValue
        row.Fill.Size = Vector2.new(math.max(0, (barRect.w - 2) * values[channel] / 255), barRect.h - 2)
        if refresh then
            row.Label.Visible = true
            row.Box.Visible = true
            row.BoxBorder.Visible = true
            row.Value.Visible = true
            row.Bar.Visible = true
            row.Fill.Color = channel == "R" and Color3.fromRGB(255, 70, 70)
                or channel == "G" and Color3.fromRGB(70, 255, 100)
                or Color3.fromRGB(70, 130, 255)
            row.Fill.Visible = true
            row.BarBorder.Visible = true
        end
    end
end

function WindowMethods:_render()
    self:_ensureFrame()
    self._visibilityRefresh = false
    local shouldDraw = self.Visible and Library.Toggled and not Library._unloaded
    if not shouldDraw then
        if not self._allHidden then
            for _, object in ipairs(self._drawings) do object.Visible = false end
            self._allHidden = true
        end
        return
    end

    if self._allHidden then
        self._allHidden = false
        self._visibilityDirty = true
    end

    -- Only clear stale drawings after a structural visibility change. Clearing
    -- every frame made Matcha visibly flicker and generated heavy property traffic.
    if self._visibilityDirty then
        for _, object in ipairs(self._drawings) do object.Visible = false end
        self._visibilityDirty = false
        self._visibilityRefresh = true
    end

    self.MousePosition = Vector2.new(Mouse.X, Mouse.Y)
    local position, size = self.Position, self.Size
    local frame = self.Frame

    frame.Background.Position = position
    frame.Background.Size = size
    frame.Background.Visible = true
    frame.Header.Position = Vector2.new(position.X + 1, position.Y + 1)
    frame.Header.Size = Vector2.new(size.X - 2, ui(24))
    frame.Header.Visible = true
    frame.Border.Position = position
    frame.Border.Size = size
    frame.Border.Visible = true
    frame.InnerBorder.Position = Vector2.new(position.X + 1, position.Y + 1)
    frame.InnerBorder.Size = Vector2.new(size.X - 2, size.Y - 2)
    frame.InnerBorder.Visible = true
    frame.Accent.Position = Vector2.new(position.X + 1, position.Y + 1)
    frame.Accent.Size = Vector2.new(size.X - 2, 2)
    frame.Accent.Visible = true
    frame.Title.Text = self.Title
    frame.Title.Position = Vector2.new(position.X + ui(7), position.Y + ui(6) + TEXT_Y_OFFSET)
    frame.Title.Visible = true
    frame.TabLine.From = Vector2.new(position.X + 1, position.Y + ui(48))
    frame.TabLine.To = Vector2.new(position.X + size.X - 1, position.Y + ui(48))
    frame.TabLine.Visible = true

    self._headerRect = { x = position.X, y = position.Y, w = size.X, h = ui(24) }
    local tabCount = #self.TabList
    if tabCount > 0 then
        local tabWidth = (size.X - ui(12)) / tabCount
        for index, tab in ipairs(self.TabList) do
            local pack = self:_ensureTabPack(tab)
            local x = position.X + ui(6) + (index - 1) * tabWidth
            tab._rect = { x = x, y = position.Y + ui(27), w = tabWidth, h = ui(20) }
            pack.Background.Position = Vector2.new(x, position.Y + ui(27))
            pack.Background.Size = Vector2.new(tabWidth, ui(20))
            pack.Background.Color = tab == self.ActiveTab and Library.MainColor or Library.BackgroundColor
            pack.Background.Visible = true
            pack.Text.Text = tab.Name
            pack.Text.Position = Vector2.new(x + tabWidth / 2, position.Y + ui(32) + TEXT_Y_OFFSET + TAB_TEXT_Y_OFFSET)
            pack.Text.Visible = true
            pack.Accent.Position = Vector2.new(x, position.Y + 27)
            pack.Accent.Size = Vector2.new(tabWidth, 2)
            pack.Accent.Visible = tab == self.ActiveTab
        end
    end

    self._activeControls = {}
    self._activeTabboxPages = {}
    local activeTab = self.ActiveTab
    if activeTab then
        local gap = ui(8)
        local columnWidth = math.floor((size.X - ui(24)) / 2)
        local leftX = position.X + ui(8)
        local rightX = leftX + columnWidth + gap
        local leftY = position.Y + ui(56)
        local rightY = position.Y + ui(56)

        for _, group in ipairs(activeTab.Groups) do
            if group.Side == 1 then
                local height = self:_renderGroup(group, leftX, leftY, columnWidth, self._activeControls)
                leftY = leftY + height + ui(8)
            else
                local height = self:_renderGroup(group, rightX, rightY, columnWidth, self._activeControls)
                rightY = rightY + height + ui(8)
            end
        end

        for _, tabbox in ipairs(activeTab.TabboxesList) do
            if tabbox.Side == 1 then
                local height = self:_renderTabbox(tabbox, leftX, leftY, columnWidth, self._activeControls)
                leftY = leftY + height + ui(8)
            else
                local height = self:_renderTabbox(tabbox, rightX, rightY, columnWidth, self._activeControls)
                rightY = rightY + height + ui(8)
            end
            for _, page in ipairs(tabbox.TabList) do table.insert(self._activeTabboxPages, { Box = tabbox, Page = page }) end
        end
    end

    if self.OpenDropdown then self:_renderDropdownOverlay(self.OpenDropdown) end
    if self.OpenColorPicker then self:_renderColorPickerOverlay(self.OpenColorPicker) end
    self._visibilityRefresh = false
end

function WindowMethods:_handleDropdownClick(mousePosition)
    local control = self.OpenDropdown
    if not control then return false end
    for index, rect in ipairs(control._itemRects or {}) do
        if inside(mousePosition, rect) then
            local value = control.Values[index]
            if control.Multi then
                control.Value[value] = not (control.Value[value] == true)
            else
                control.Value = value
                self.OpenDropdown = nil
            end
            self._visibilityDirty = true
            safeCallback(control.Callback, control.Value)
            safeCallback(control.Changed, control.Value)
            return true
        end
    end
    if not inside(mousePosition, control._listRect) and not inside(mousePosition, control._boxRect) then
        self.OpenDropdown = nil
        self._visibilityDirty = true
    end
    return false
end

function WindowMethods:_setColorChannel(control, channel, numberValue)
    local r = math.floor(control.Value.R * 255 + 0.5)
    local g = math.floor(control.Value.G * 255 + 0.5)
    local b = math.floor(control.Value.B * 255 + 0.5)
    numberValue = clamp(math.floor((tonumber(numberValue) or 0) + 0.5), 0, 255)
    if channel == "R" then r = numberValue end
    if channel == "G" then g = numberValue end
    if channel == "B" then b = numberValue end
    control._pickerHue = nil
    control:SetValueRGB(Color3.fromRGB(r, g, b), control.Transparency)
end

function WindowMethods:_updateColorDrag(mousePosition, mouseDown)
    local drag = self.ColorDrag
    if not drag then return end
    if not mouseDown then self.ColorDrag = nil return end
    local control = drag.Control
    if not control or self.OpenColorPicker ~= control then self.ColorDrag = nil return end

    if drag.Kind == "SV" and control._svRect then
        local saturation = clamp((mousePosition.X - control._svRect.x) / control._svRect.w, 0, 1)
        local value = 1 - clamp((mousePosition.Y - control._svRect.y) / control._svRect.h, 0, 1)
        local hue = control._pickerHue or 0
        control:SetValueRGB(hsvToRgb(hue, saturation, value), control.Transparency)
    elseif drag.Kind == "Hue" and control._hueRect then
        local hue = clamp((mousePosition.Y - control._hueRect.y) / control._hueRect.h, 0, 0.9999)
        local _, saturation, value = rgbToHsv(control.Value)
        control._pickerHue = hue
        control:SetValueRGB(hsvToRgb(hue, saturation, value), control.Transparency)
    elseif drag.Kind == "RGB" and control._rgbRects and control._rgbRects[drag.Channel] then
        local rect = control._rgbRects[drag.Channel].Bar
        local percent = clamp((mousePosition.X - rect.x) / rect.w, 0, 1)
        self:_setColorChannel(control, drag.Channel, percent * 255)
    end
end

function WindowMethods:_startColorInput(control, channel)
    local current = channel == "R" and control.Value.R or channel == "G" and control.Value.G or control.Value.B
    self.ColorInput = {
        Control = control, Channel = channel,
        Buffer = tostring(math.floor(current * 255 + 0.5)),
        Replace = true, Ready = false, Keys = {}
    }
end

function WindowMethods:_finishColorInput(applyValue)
    local input = self.ColorInput
    if not input then return end
    if applyValue and input.Buffer ~= "" then
        self:_setColorChannel(input.Control, input.Channel, tonumber(input.Buffer) or 0)
    end
    self.ColorInput = nil
end

function WindowMethods:_updateColorInput(mouseDown)
    local input = self.ColorInput
    if not input then return false end
    if not input.Ready then
        if not mouseDown then input.Ready = true end
        return true
    end

    local function pressedOnce(code)
        local pressed = iskeypressed(code)
        local once = pressed and not input.Keys[code]
        input.Keys[code] = pressed
        return once
    end

    if pressedOnce(0x1B) then self:_finishColorInput(false) return true end
    if pressedOnce(0x0D) then self:_finishColorInput(true) return true end
    if pressedOnce(0x08) then
        input.Buffer = string.sub(input.Buffer, 1, math.max(0, #input.Buffer - 1))
        input.Replace = false
    end
    for code = 0x30, 0x39 do
        if pressedOnce(code) then
            local digit = string.char(code)
            if input.Replace then input.Buffer = digit else input.Buffer = input.Buffer .. digit end
            input.Replace = false
            if #input.Buffer > 3 then input.Buffer = string.sub(input.Buffer, 1, 3) end
        end
    end
    return true
end

function WindowMethods:_handleColorPickerClick(mousePosition)
    local control = self.OpenColorPicker
    if not control then return false end

    if inside(mousePosition, control._svRect) then
        self.ColorDrag = { Control = control, Kind = "SV" }
        self:_updateColorDrag(mousePosition, true)
        return true
    end
    if inside(mousePosition, control._hueRect) then
        self.ColorDrag = { Control = control, Kind = "Hue" }
        self:_updateColorDrag(mousePosition, true)
        return true
    end
    for _, channel in ipairs({ "R", "G", "B" }) do
        local rects = control._rgbRects and control._rgbRects[channel]
        if rects and inside(mousePosition, rects.Box) then
            self:_startColorInput(control, channel)
            return true
        end
        if rects and inside(mousePosition, rects.Bar) then
            self.ColorDrag = { Control = control, Kind = "RGB", Channel = channel }
            self:_updateColorDrag(mousePosition, true)
            return true
        end
    end
    if inside(mousePosition, control._pickerRect) then return true end
    if inside(mousePosition, control._boxRect) then
        self.OpenColorPicker = nil
        self.ColorInput = nil
        self._visibilityDirty = true
        return true
    end

    self.OpenColorPicker = nil
    self.ColorInput = nil
    self.ColorDrag = nil
    self._visibilityDirty = true
    return false
end

function WindowMethods:_startKeyCapture(control)
    self.CaptureKey = control
    self.CaptureReady = false
end

function WindowMethods:_updateKeyCapture()
    local control = self.CaptureKey
    if not control then return false end
    if not self.CaptureReady then
        if not ismouse1pressed() then self.CaptureReady = true end
        return true
    end

    local chosen = nil
    if ismouse2pressed() then chosen = "MB2" end
    if not chosen then
        for code = 1, 255 do
            if iskeypressed(code) then chosen = keyName(code); break end
        end
    end
    if chosen then
        if chosen == "Escape" then chosen = "None" end
        control.Value = chosen
        safeCallback(control.Callback, control.Value)
        safeCallback(control.Changed, control.Value)
        self.CaptureKey = nil
        self.CaptureReady = false
    end
    return true
end

function WindowMethods:_updateInputCapture()
    local control = self.CaptureInput
    if not control then return false end
    if not self.CaptureReady then
        if not ismouse1pressed() then self.CaptureReady = true end
        return true
    end

    self._inputKeys = self._inputKeys or {}
    local enter = iskeypressed(0x0D)
    if enter and not self._inputKeys[0x0D] then
        self.CaptureInput = nil
        safeCallback(control.Callback, control.Value)
        safeCallback(control.Changed, control.Value)
        self._inputKeys[0x0D] = true
        return true
    end
    self._inputKeys[0x0D] = enter

    local backspace = iskeypressed(0x08)
    if backspace and not self._inputKeys[0x08] then
        control.Value = string.sub(control.Value, 1, math.max(0, #control.Value - 1))
        if not control.Finished then safeCallback(control.Callback, control.Value) end
    end
    self._inputKeys[0x08] = backspace

    local space = iskeypressed(0x20)
    if space and not self._inputKeys[0x20] and not control.Numeric then
        control.Value = control.Value .. " "
        if not control.Finished then safeCallback(control.Callback, control.Value) end
    end
    self._inputKeys[0x20] = space

    for code = 0x30, 0x5A do
        local valid = (code >= 0x30 and code <= 0x39) or (code >= 0x41 and code <= 0x5A and not control.Numeric)
        if valid then
            local pressed = iskeypressed(code)
            if pressed and not self._inputKeys[code] then
                control.Value = control.Value .. string.char(code)
                if not control.Finished then safeCallback(control.Callback, control.Value) end
            end
            self._inputKeys[code] = pressed
        end
    end
    return true
end

function WindowMethods:_updateKeyPickers()
    local reservedMenuCode = nil
    for _, picker in ipairs(Library.KeyPickerList) do
        if picker.Window == self and picker.IsMenuKey then
            reservedMenuCode = keyCode(picker.Value)
            break
        end
    end
    for _, picker in ipairs(Library.KeyPickerList) do
        if picker.Window == self and picker ~= self.CaptureKey then
            local state = picker:GetState()
            -- The menu key is reserved. A feature bound to the same key must not
            -- fire when the user only intends to hide or show the interface.
            if reservedMenuCode and not picker.IsMenuKey and keyCode(picker.Value) == reservedMenuCode then
                picker.LastState = state
            else
            if picker.Mode == "Always" then state = true end

            if picker.Mode == "Hold" then
                if picker.Attached and picker.SyncToggleState and picker.Attached.Value ~= state then
                    picker.Attached:SetValue(state)
                end
                if state ~= picker.LastState then safeCallback(picker.Callback, state) end
            elseif picker.Mode == "Toggle" then
                if state and not picker.LastState then
                    if picker.Attached and picker.SyncToggleState then picker.Attached:SetValue(not picker.Attached.Value) end
                    safeCallback(picker.Callback, true)
                    safeCallback(picker.Clicked, true)
                end
            elseif picker.Mode == "Always" and not picker.LastState then
                safeCallback(picker.Callback, true)
            end
            picker.LastState = state
            end
        end
    end
end

function WindowMethods:Step()
    if self.Destroyed or Library._unloaded then return end
    if Library.RainbowEnabled then
        Library:SetAccentColor(hsvToRgb((os.clock() * Library.RainbowSpeed) % 1, 0.9, 1))
    end
    self:_render()

    local mousePosition = self.MousePosition or Vector2.new(Mouse.X, Mouse.Y)
    local mouseDown = ismouse1pressed()
    local mouseClick = mouseDown and not self.LastMouseDown

    self:_updateColorDrag(mousePosition, mouseDown)
    if self:_updateColorInput(mouseDown) then self.LastMouseDown = mouseDown return end
    self:_updateKeyPickers()
    if self:_updateKeyCapture() then self.LastMouseDown = mouseDown return end
    if self:_updateInputCapture() then self.LastMouseDown = mouseDown return end

    if self.SliderDrag then
        if mouseDown then
            local control = self.SliderDrag
            local rect = control._barRect
            if rect then
                local percent = clamp((mousePosition.X - rect.x) / rect.w, 0, 1)
                control:SetValue(control.Min + (control.Max - control.Min) * percent)
            end
        else
            self.SliderDrag = nil
        end
    end

    if self.Dragging then
        if mouseDown then
            local dx = mousePosition.X - self.DragStartMouse.X
            local dy = mousePosition.Y - self.DragStartMouse.Y
            self.Position = Vector2.new(self.DragStartPosition.X + dx, self.DragStartPosition.Y + dy)
        else
            self.Dragging = false
        end
    end

    if mouseClick then
        if self:_handleDropdownClick(mousePosition) then self.LastMouseDown = mouseDown return end
        if self:_handleColorPickerClick(mousePosition) then self.LastMouseDown = mouseDown return end

        for _, tab in ipairs(self.TabList) do
            if inside(mousePosition, tab._rect) then
                self.ActiveTab = tab
                self.OpenDropdown = nil
                self.OpenColorPicker = nil
                self.ColorInput = nil
                self._visibilityDirty = true
                self.LastMouseDown = mouseDown
                return
            end
        end

        for _, entry in ipairs(self._activeTabboxPages or {}) do
            if inside(mousePosition, entry.Page._tabRect) then
                entry.Box.Active = entry.Page
                self.OpenDropdown = nil
                self.OpenColorPicker = nil
                self.ColorInput = nil
                self._visibilityDirty = true
                self.LastMouseDown = mouseDown
                return
            end
        end

        local handled = false
        for _, control in ipairs(self._activeControls or {}) do
            if not handled and inside(mousePosition, control._rect) then
                if control.Type == "Toggle" then
                    control:SetValue(not control.Value)
                    handled = true
                elseif control.Type == "Button" then
                    safeCallback(control.Callback)
                    safeCallback(control.Clicked)
                    handled = true
                elseif control.Type == "Slider" and inside(mousePosition, control._barRect) then
                    self.SliderDrag = control
                    local percent = clamp((mousePosition.X - control._barRect.x) / control._barRect.w, 0, 1)
                    control:SetValue(control.Min + (control.Max - control.Min) * percent)
                    handled = true
                elseif control.Type == "Dropdown" and inside(mousePosition, control._boxRect) then
                    self.OpenDropdown = self.OpenDropdown == control and nil or control
                    self.OpenColorPicker = nil
                    self.ColorInput = nil
                    self._visibilityDirty = true
                    handled = true
                elseif control.Type == "Input" and inside(mousePosition, control._boxRect) then
                    self.CaptureInput = control
                    self.CaptureReady = false
                    handled = true
                elseif control.Type == "KeyPicker" and inside(mousePosition, control._boxRect) then
                    self:_startKeyCapture(control)
                    handled = true
                elseif control.Type == "ColorPicker" and inside(mousePosition, control._boxRect) then
                    self.OpenColorPicker = self.OpenColorPicker == control and nil or control
                    self.OpenDropdown = nil
                    self.ColorInput = nil
                    self.ColorDrag = nil
                    if self.OpenColorPicker then
                        local hue = rgbToHsv(control.Value)
                        control._pickerHue = hue
                    end
                    self._visibilityDirty = true
                    handled = true
                end
            end
        end

        if not handled and inside(mousePosition, self._headerRect) then
            self.Dragging = true
            self.DragStartMouse = mousePosition
            self.DragStartPosition = self.Position
        end
    end

    self.LastMouseDown = mouseDown
end

function WindowMethods:SetWindowTitle(title)
    self.Title = tostring(title or "")
    return self
end

function WindowMethods:AddTab(name)
    name = tostring(name or ("Tab " .. tostring(#self.TabList + 1)))
    if name == "Settings" and self._settingsTab then return self._settingsTab end
    local tab = setmetatable({
        Name = name,
        Window = self, Groups = {}, Groupboxes = {}, Tabboxes = {}, TabboxesList = {},
        LayoutOrder = #self.TabList + 1
    }, TabMethods)
    if self._settingsTab and not self._creatingSettings then
        table.insert(self.TabList, #self.TabList, tab)
        self._hasUserTab = true
        if self.ActiveTab == self._settingsTab then self.ActiveTab = tab end
    else
        table.insert(self.TabList, tab)
    end
    for index, listedTab in ipairs(self.TabList) do listedTab.LayoutOrder = index end
    self.Tabs[tab.Name] = tab
    if not self.ActiveTab then self.ActiveTab = tab end
    return tab
end

function WindowMethods:_centerOnScreen()
    pcall(function()
        local viewport = workspace.CurrentCamera.ViewportSize
        self.Position = Vector2.new((viewport.X - self.Size.X) / 2, (viewport.Y - self.Size.Y) / 2)
    end)
    return self
end

function WindowMethods:_buildSettingsTab(defaultWidth, defaultHeight)
    self._creatingSettings = true
    local tab = self:AddTab("Settings")
    self._creatingSettings = false
    self._settingsTab = tab

    local suffix = tostring(#Library.Windows + 1)
    local appearance = tab:AddLeftGroupbox("Appearance")
    appearance:AddColorPicker("UESettingsAccent" .. suffix, {
        Text = "Accent Color",
        Default = Library.StaticAccentColor,
        Callback = function(color)
            Library.StaticAccentColor = color
            if not Library.RainbowEnabled then Library:SetAccentColor(color) end
            self._visibilityDirty = true
        end
    })
    appearance:AddToggle("UESettingsRainbow" .. suffix, {
        Text = "Rainbow Mode",
        Default = Library.RainbowEnabled,
        Callback = function(value)
            Library.RainbowEnabled = value
            if not value then Library:SetAccentColor(Library.StaticAccentColor) end
            self._visibilityDirty = true
        end
    })
    appearance:AddSlider("UESettingsRainbowSpeed" .. suffix, {
        Text = "Rainbow Speed", Min = 0.03, Max = 1, Default = Library.RainbowSpeed,
        Rounding = 2, Callback = function(value) Library.RainbowSpeed = value end
    })

    local sizing = tab:AddRightGroupbox("Window")
    sizing:AddSlider("UESettingsWidth" .. suffix, {
        Text = "Width", Min = 380, Max = 1000, Default = defaultWidth,
        Rounding = 0, Suffix = " px", Callback = function(value)
            self.Size = Vector2.new(value, self.Size.Y)
            self._visibilityDirty = true
        end
    })
    sizing:AddSlider("UESettingsHeight" .. suffix, {
        Text = "Height", Min = 300, Max = 1000, Default = defaultHeight,
        Rounding = 0, Suffix = " px", Callback = function(value)
            self.Size = Vector2.new(self.Size.X, value)
            self._visibilityDirty = true
        end
    })
    sizing:AddButton({ Text = "Center Window", Func = function() self:_centerOnScreen() end })
    sizing:AddButton({ Text = "Reset Size", Func = function()
        self.Size = Vector2.new(defaultWidth, defaultHeight)
        Options["UESettingsWidth" .. suffix]:SetValue(defaultWidth)
        Options["UESettingsHeight" .. suffix]:SetValue(defaultHeight)
        self:_centerOnScreen()
        self._visibilityDirty = true
    end })

    local controls = tab:AddRightGroupbox("Controls")
    local menuPicker = controls:AddKeyPicker("UESettingsMenuKey" .. suffix, {
        Text = "Show / Hide UI", Default = "End", Mode = "Toggle",
        Callback = function(pressed) if pressed then self:Toggle() end end
    })
    menuPicker.IsMenuKey = true
    controls:AddButton({ Text = "Unload UI", Func = function() Library:Unload() end })

    return tab
end

function WindowMethods:Show()
    self.Visible = true
    Library.Toggled = true
    self._visibilityDirty = true
    return self
end

function WindowMethods:Hide()
    self.Visible = false
    self.OpenDropdown = nil
    self.OpenColorPicker = nil
    self.ColorInput = nil
    self.ColorDrag = nil
    self.SliderDrag = nil
    return self
end

function WindowMethods:Toggle()
    self.Visible = not self.Visible
    self.OpenDropdown = nil
    self.OpenColorPicker = nil
    self.ColorInput = nil
    self.ColorDrag = nil
    self.SliderDrag = nil
    if self.Visible then self._visibilityDirty = true end
    return self.Visible
end

function WindowMethods:Destroy()
    self.Destroyed = true
    for _, object in ipairs(self._drawings) do removeDrawing(object) end
end

function Library:CreateWindow(...)
    local first = select(1, ...)
    local info
    if type(first) == "table" then
        info = first
    else
        info = { Title = tostring(first or "UE Matcha") }
    end

    local width, height = 620, 1040
    if info.Size then
        pcall(function()
            width = info.Size.X
            height = info.Size.Y
        end)
    end
    if type(info.Width) == "number" then width = info.Width end
    if type(info.Height) == "number" then height = info.Height end
    width = math.floor(width * UI_SCALE + 0.5)
    height = math.floor(height * UI_SCALE + 0.5)

    local position = Vector2.new(100, 100)
    if info.Position then
        pcall(function() position = Vector2.new(info.Position.X, info.Position.Y) end)
    elseif info.Center ~= false then
        pcall(function()
            local camera = workspace.CurrentCamera
            local viewport = camera.ViewportSize
            position = Vector2.new((viewport.X - width) / 2, (viewport.Y - height) / 2)
        end)
    end

    local window = setmetatable({
        Title = info.Title or "UE Matcha",
        Position = position,
        Size = Vector2.new(width, height),
        Visible = info.AutoShow ~= false,
        Tabs = {}, TabList = {}, ActiveTab = nil,
        _drawings = {}, _activeControls = {}, _activeTabboxPages = {},
        LastMouseDown = false, Destroyed = false,
        MousePosition = Vector2.new(Mouse.X, Mouse.Y),
        _visibilityDirty = true, _allHidden = false
    }, WindowMethods)

    table.insert(self.Windows, window)
    self.Toggled = window.Visible
    window:_buildSettingsTab(width, height)

    task.spawn(function()
        while not Library._unloaded and not window.Destroyed do
            local ok, err = pcall(function() window:Step() end)
            if not ok then
                warn("UE Matcha UI step error: " .. tostring(err))
                task.wait(0.25)
            else
                task.wait(0.016)
            end
        end
    end)

    return window
end

function Library:Toggle()
    self.Toggled = not self.Toggled
    for _, window in ipairs(self.Windows) do
        window.Visible = self.Toggled
        if self.Toggled then window._visibilityDirty = true end
    end
    return self.Toggled
end

function Library:Unload()
    if self._unloaded then return end
    self._unloaded = true
    self.Toggled = false
    for _, callback in ipairs(self.UnloadCallbacks) do safeCallback(callback) end
    for _, object in ipairs(self._drawings) do removeDrawing(object) end
    self.Unloaded = true
end

-- Compatibility no-ops for source-only registry/signal helpers.
function Library:AddToRegistry(instance) return instance end
function Library:RemoveFromRegistry(instance) return instance end
function Library:GiveSignal(signal) return signal end
function Library:AddToolTip(text, object) return object end
function Library:MouseIsOverOpenedFrame() return false end
function Library:IsMouseOverFrame() return false end
function Library:UpdateDependencyBoxes() end
function Library:SetNotifySide(side) self.NotifyConfig.Alignment = side end
function Library:SetNotifyPosition(x, y)
    self.NotifyConfig.PositionX = x or 0
    self.NotifyConfig.PositionY = y or 40
end
function Library:ApplyGlow(instance) return instance end
function Library:ApplyTextStroke(instance) return instance end
function Library:MakeDraggable(instance) return instance end
function Library:OnHighlight(instance) return instance end
function Library:Create() return nil end
function Library:CreateLabel() return nil end
function Library:GetTextBounds(text, font, size)
    local fontSize = tonumber(size) or self.FontSize
    return #tostring(text or "") * fontSize * 0.55, fontSize + 2
end

Environment.Library = Library
Environment.UELibrary = Library
Environment.Toggles = Toggles
Environment.Options = Options

return Library
