    })
end):SetRisk()

local last = 0
task.spawn(function()
    while running do
        task.wait(cfg.fps)
        if not cfg.on then
            hide()
            task.wait(0.1)
            continue
        end
        local char = me.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then hide(); continue end
        local now = os.clock()
        if now - ctimer >= 5 then
            rebuild()
            ctimer = now
        end
        local pos = hrp.Position
        local hit = false
        if cfg.mode == 1 or cfg.mode == 3 then
            for _, c in next, cache do
                if not c then continue end
                if c.Name == mname then continue end
                local h = c:FindFirstChild("HumanoidRootPart")
                if not h then continue end
                local dx = h.Position.X - pos.X
                local dy = h.Position.Y - pos.Y
                local dz = h.Position.Z - pos.Z
                local d2 = dx * dx + dy * dy + dz * dz
                if d2 >= cfg.i2 and d2 <= cfg.o2 then hit = true; break end
            end
        elseif cfg.mode == 2 then
            for _, c in next, cache do
                if not c then continue end
                if c.Name == mname then continue end
                local h = c:FindFirstChild("HumanoidRootPart")
                if not h then continue end
                local dx = math.abs(h.Position.X - pos.X)
                local dy = math.abs(h.Position.Y - pos.Y)
                local dz = math.abs(h.Position.Z - pos.Z)
                if dx <= cfg.csize and dy <= cfg.csize and dz <= cfg.csize then hit = true; break end
            end
        end
        draw(pos, hit)
        if hit then
            if now - last >= cfg.cdelay then
                mouse1click()
                last = now
            end
        end
    end
    hide()
end)
