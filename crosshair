local function applyPreset(name)
    local presets = {
        Classic = { shape="Lines", h=18, v=18, gap=5, thickness=2, dot=true, spin=false, gradient=false, rainbow=false, pulse=false, glow=false },
        ["Tiny Dot"] = { shape="Circle", h=2, v=2, gap=0, thickness=1, dot=true, spin=false, gradient=false, rainbow=false, pulse=false, glow=false },
        Sniper = { shape="Lines", h=62, v=42, gap=12, thickness=1, dot=true, spin=false, gradient=false, rainbow=false, pulse=false, glow=false },
        Neon = { shape="X", h=34, v=34, gap=7, thickness=3, dot=true, spin=false, gradient=true, rainbow=false, pulse=false, glow=true },
        Animated = { shape="Chevrons", h=38, v=38, gap=9, thickness=2, dot=true, spin=true, gradient=true, rainbow=true, pulse=true, glow=true }
    }
    local p = presets[name]
    if not p then return end
    setOption("crosshair_size", math.max(p.h, p.v))
    setOption("crosshair_shape", p.shape)
    setOption("crosshair_horizontal_size", p.h)
    setOption("crosshair_vertical_size", p.v)
    setOption("crosshair_gap", p.gap)
    setOption("crosshair_thickness", p.thickness)
    setOption("crosshair_outline_thickness", 1)
    setToggle("crosshair_dot", p.dot)
    setToggle("crosshair_spin", p.spin)
    setToggle("crosshair_gradient", p.gradient)
    setToggle("crosshair_rainbow", p.rainbow)
    setToggle("crosshair_pulse", p.pulse)
    setToggle("crosshair_glow", p.glow)
end
for _, name in ipairs({ "Classic", "Tiny Dot", "Sniper", "Neon", "Animated" }) do
