local camera = workspace.CurrentCamera
local viewport = camera.ViewportSize
local currentX, currentY = viewport.X / 2, viewport.Y / 2
local lastTime = os.clock()

local function layoutEdge(line, from, to, side, width, fillWidth, visible, color, opacity)
    local vx, vy = to.X - from.X, to.Y - from.Y
    local length = math.sqrt(vx * vx + vy * vy)
    local nx, ny = -vy / math.max(length, 0.001), vx / math.max(length, 0.001)
    local offset = side * (fillWidth / 2 + width / 2)
    line.From = Vector2.new(from.X + nx * offset, from.Y + ny * offset)
    line.To = Vector2.new(to.X + nx * offset, to.Y + ny * offset)
    line.Thickness = math.max(1, width)
    line.Color, line.Transparency = color, opacity
    line.Visible = visible and width > 0
    return nx, ny
end

task.spawn(function()
    while S.running do
        local now = os.clock()
        local dt = clamp(now - lastTime, 0, 0.1)
        lastTime = now

        local okViewport, newViewport = pcall(function() return workspace.CurrentCamera.ViewportSize end)
        if okViewport and newViewport then viewport = newViewport end
        local targetX = S.followMouse and Mouse.X or viewport.X / 2
        local targetY = S.followMouse and Mouse.Y or viewport.Y / 2

        if S.smoothFollow then
            local alpha = clamp(dt * S.followSpeed, 0, 1)
            currentX = currentX + (targetX - currentX) * alpha
            currentY = currentY + (targetY - currentY) * alpha
        else
            currentX, currentY = targetX, targetY
        end

        local angle = S.spin and math.rad(now * S.spinSpeed) or 0
        local pulseScale = 1
        if S.pulse then pulseScale = 1 + math.sin(now * S.pulseSpeed * math.pi * 2) * S.pulseAmount end
        local circleShape = S.shape == "Circle"

        for index, arm in ipairs(arms) do
            local baseAngle = S.shape == "X" and math.pi / 4 or 0
            local armAngle = angle + baseAngle + (index - 1) * math.pi / 2
            local dx, dy = math.cos(armAngle), math.sin(armAngle)
            local startDistance = S.gap
            local baseSize = (index % 2 == 1) and S.horizontalSize or S.verticalSize
            local armSize = math.max(1, baseSize * pulseScale)
            local endDistance = S.gap + armSize
            local startPoint = Vector2.new(currentX + dx * startDistance, currentY + dy * startDistance)
            local endPoint = Vector2.new(currentX + dx * endDistance, currentY + dy * endDistance)
            local chevron = S.shape == "Chevrons"
            local side = index % 2 == 1 and 1 or -1
            local middleDistance = startDistance + armSize / 2
            local bend = armSize * 0.22 * side
            local middlePoint = Vector2.new(currentX + dx * middleDistance - dy * bend, currentY + dy * middleDistance + dx * bend)
            local outlineVisible = S.enabled and S.outline and not circleShape
            local firstEnd = chevron and middlePoint or endPoint
            local sideWidth = S.sideOutlineThickness
            local nx, ny = layoutEdge(arm.outline, startPoint, firstEnd, -1, sideWidth, S.thickness, outlineVisible, S.outlineColor, S.opacity)
            layoutEdge(arm.lowerOutline, startPoint, firstEnd, 1, sideWidth, S.thickness, outlineVisible, S.outlineColor, S.opacity)
            layoutEdge(arm.outlineSecond, middlePoint, endPoint, -1, sideWidth, S.thickness, outlineVisible and chevron, S.outlineColor, S.opacity)
            layoutEdge(arm.lowerOutlineSecond, middlePoint, endPoint, 1, sideWidth, S.thickness, outlineVisible and chevron, S.outlineColor, S.opacity)
            local halfCap = S.thickness / 2 + sideWidth
            arm.startCap.From = Vector2.new(startPoint.X - nx * halfCap, startPoint.Y - ny * halfCap)
            arm.startCap.To = Vector2.new(startPoint.X + nx * halfCap, startPoint.Y + ny * halfCap)
            local capDx, capDy = endPoint.X - (chevron and middlePoint.X or startPoint.X), endPoint.Y - (chevron and middlePoint.Y or startPoint.Y)
            local capLength = math.sqrt(capDx * capDx + capDy * capDy)
            local endNx, endNy = -capDy / math.max(capLength, 0.001), capDx / math.max(capLength, 0.001)
            arm.endCap.From = Vector2.new(endPoint.X - endNx * halfCap, endPoint.Y - endNy * halfCap)
            arm.endCap.To = Vector2.new(endPoint.X + endNx * halfCap, endPoint.Y + endNy * halfCap)
            for _, cap in ipairs({ arm.startCap, arm.endCap }) do
                cap.Thickness = math.max(1, S.capOutlineThickness)
                cap.Color, cap.Transparency = S.outlineColor, S.opacity
                cap.Visible = outlineVisible and S.capOutlineThickness > 0
            end
            for glowIndex, glowLine in ipairs({ arm.glowWide, arm.glowNear, arm.glowWideSecond, arm.glowNearSecond }) do
                local second = glowIndex > 2
                glowLine.From, glowLine.To = second and middlePoint or startPoint, (chevron and not second) and middlePoint or endPoint
                glowLine.Thickness = S.thickness + ((glowIndex % 2 == 1) and 10 or 5)
                glowLine.Color = gradientColor(0.5, index, now)
                glowLine.Transparency = S.opacity * S.glowIntensity * ((glowIndex % 2 == 1) and 0.22 or 0.4)
                glowLine.Visible = S.enabled and S.glow and not circleShape and (not second or chevron)
            end

            local quality = math.max(4, math.min(MAX_SEGMENTS, math.floor(S.gradientQuality + 0.5)))
            for segmentIndex, segmentLine in ipairs(arm.segments) do
                if segmentIndex <= quality and not circleShape then
                    local t0 = (segmentIndex - 1) / quality
                    local t1 = segmentIndex / quality
                    local d0 = startDistance + armSize * t0
                    -- A tiny overlap hides pixel gaps without creating dark/color bands.
                    local d1 = startDistance + armSize * t1 + (segmentIndex < quality and 0.08 or 0)
                    local bend0 = 0
                    local bend1 = 0
                    if S.shape == "Chevrons" then
                        local side = index % 2 == 1 and 1 or -1
                        bend0 = (1 - math.abs(2 * t0 - 1)) * armSize * 0.22 * side
                        bend1 = (1 - math.abs(2 * t1 - 1)) * armSize * 0.22 * side
                    end
                    segmentLine.From = Vector2.new(currentX + dx * d0 - dy * bend0, currentY + dy * d0 + dx * bend0)
                    segmentLine.To = Vector2.new(currentX + dx * d1 - dy * bend1, currentY + dy * d1 + dx * bend1)
                    segmentLine.Thickness = S.thickness
                    segmentLine.Color = gradientColor((t0 + t1) / 2, index, now)
                    segmentLine.Transparency = S.opacity
                    segmentLine.Visible = S.enabled
                else
                    segmentLine.Visible = false
                end
            end
        end

        local radius = S.gap + math.max(S.horizontalSize, S.verticalSize) * pulseScale
        if S.shape == "Circle" and radius <= 3 then radius = math.max(1, radius) end
        for index, part in ipairs(ring) do
            local visible = S.enabled and circleShape and radius > 3
            if visible then
                local a0 = angle + (index - 1) * math.pi * 2 / RING_SEGMENTS
                local a1 = angle + index * math.pi * 2 / RING_SEGMENTS
                local from = Vector2.new(currentX + math.cos(a0) * radius, currentY + math.sin(a0) * radius)
                local to = Vector2.new(currentX + math.cos(a1) * radius, currentY + math.sin(a1) * radius)
                local color = gradientColor((index - 0.5) / RING_SEGMENTS, 1, now)
                part.outline.From, part.outline.To = from, to
                part.outline.Thickness = S.thickness + 2 * S.outlineThickness
                part.outline.Color = S.outlineColor
                part.outline.Transparency = S.opacity
                part.outline.Visible = S.outline and S.outlineThickness > 0
                part.glow.From, part.glow.To = from, to
                part.glow.Thickness = S.thickness + 8
                part.glow.Color = color
                part.glow.Transparency = S.opacity * S.glowIntensity * 0.28
                part.glow.Visible = S.glow
                part.line.From, part.line.To = from, to
                part.line.Thickness = S.thickness
                part.line.Color = color
                part.line.Transparency = S.opacity
                part.line.Visible = true
            else
                part.outline.Visible, part.glow.Visible, part.line.Visible = false, false, false
            end
        end

        local dotColor = S.rainbow and hsvColor(now * S.gradientSpeed * 0.15) or S.color1
        dotOutline.Position = Vector2.new(currentX, currentY)
        dotOutline.Radius = math.max(1, S.thickness + S.outlineThickness)
        dotOutline.Color = S.outlineColor
        dotOutline.Transparency = S.opacity
        dotOutline.Visible = S.enabled and S.dot and S.outline and S.outlineThickness > 0
        dot.Position = Vector2.new(currentX, currentY)
        dot.Radius = math.max(1, S.thickness)
        dot.Color = dotColor
        dot.Transparency = S.opacity
        dot.Visible = S.enabled and S.dot

        if S.everyFrame then
            task.wait()
        else
            task.wait(1 / math.max(10, S.targetFPS))
        end
    end
end)

