local function clamp(value, minimum, maximum)
    if value < minimum then return minimum end
    if value > maximum then return maximum end
    return value
end

local function lerpColor(a, b, alpha)
    return Color3.new(
        a.R + (b.R - a.R) * alpha,
        a.G + (b.G - a.G) * alpha,
        a.B + (b.B - a.B) * alpha
    )
end

local function hsvColor(hue)
    hue = hue % 1
    local section = math.floor(hue * 6)
    local fraction = hue * 6 - section
    local q, t = 1 - fraction, fraction
    section = section % 6
    if section == 0 then return Color3.new(1, t, 0) end
    if section == 1 then return Color3.new(q, 1, 0) end
    if section == 2 then return Color3.new(0, 1, t) end
    if section == 3 then return Color3.new(0, q, 1) end
    if section == 4 then return Color3.new(t, 0, 1) end
    return Color3.new(1, 0, q)
end

local function gradientColor(t, index, now)
    if not S.gradient and not S.rainbow then return S.color1 end
    if S.gradientDirection == "Inward" then
        t = 1 - t
    elseif S.gradientDirection == "Clockwise" then
        t = (index - 1) / 4 + t / 4
    elseif S.gradientDirection == "Counterclockwise" then
        t = 1 - ((index - 1) / 4 + t / 4)
    end
    local phase = (t + now * S.gradientSpeed * 0.18) % 1
    if S.rainbow then return hsvColor(phase) end
    local stop = clamp(S.colorStop, 0.05, 0.95)
    local blend
    if phase <= stop then blend = phase / stop else blend = (1 - phase) / (1 - stop) end
    return lerpColor(S.color1, S.color2, clamp(blend, 0, 1))
end

