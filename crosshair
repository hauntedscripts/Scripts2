local drawings = {}
local arms = {}
local MAX_SEGMENTS = 48

local function make(kind, properties)
    local object = Drawing.new(kind)
    for key, value in pairs(properties) do object[key] = value end
    object.Visible = false
    table.insert(drawings, object)
    return object
end

for index = 1, 4 do
    arms[index] = {
        outline = make("Line", { Thickness = 4, Color = S.outlineColor, ZIndex = 20 }),
        segments = {}
    }
    for segment = 1, MAX_SEGMENTS do
        arms[index].segments[segment] = make("Line", { Thickness = S.thickness, Color = S.color1, ZIndex = 21 })
    end
end

local dotOutline = make("Circle", {
    Radius = 3, NumSides = 20, Thickness = 1, Filled = true,
    Color = S.outlineColor, ZIndex = 20
})
local dot = make("Circle", {
    Radius = 2, NumSides = 20, Thickness = 1, Filled = true,
    Color = S.color1, ZIndex = 21
})

local function removeAll()
    if not S.running then return end
    S.running = false
    for _, object in ipairs(drawings) do pcall(function() object:Remove() end) end
end

env.LacedCrosshair = { Unload = removeAll, Settings = S }
Library:OnUnload(removeAll)

local function clamp(value, minimum, maximum)
    if value < minimum then return minimum end
    if value > maximum then return maximum end
    return value
end

local function lerpColor(a, b, alpha)
    return Color3.new(
        a.R + (b.R - a.R) * alpha,
        a.G + (b.G - a.G) * alpha,
        a.B + (b.B - a.B) * alpha
    )
end

local function hsvColor(hue)
    hue = hue % 1
    local section = math.floor(hue * 6)
    local fraction = hue * 6 - section
    local q, t = 1 - fraction, fraction
    section = section % 6
    if section == 0 then return Color3.new(1, t, 0) end
    if section == 1 then return Color3.new(q, 1, 0) end
    if section == 2 then return Color3.new(0, 1, t) end
    if section == 3 then return Color3.new(0, q, 1) end
    if section == 4 then return Color3.new(t, 0, 1) end
    return Color3.new(1, 0, q)
end

