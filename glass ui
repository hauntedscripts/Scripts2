-- Each row: [key pill] [name pill], click the key pill to rebind
function GlassUI:AddKeybindEntry(name, keyCode, onRebind)
    local listening = false

    local row = make("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 32),
        Parent = KeybindList,
    })
    make("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 8),
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = row,
    })

    -- Key pill (fixed-ish width, auto-sizes a bit with padding)
    local keyPill = make("TextButton", {
        Text = "",
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 1, 0),
        Parent = row,
    })
    applyPill(keyPill, Theme.Pill, 0.15)
    make("UIPadding", {
        PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), Parent = keyPill,
    })
    local keyLabel = make("TextLabel", {
        Text = keyCode.Name,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 1, 0),
        Parent = keyPill,
    })

    -- Name pill (auto width, fills remaining feel via padding)
    local namePill = make("Frame", {
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 1, 0),
        Parent = row,
    })
    applyPill(namePill, Theme.Pill, 0.15)
    make("UIPadding", {
        PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), Parent = namePill,
    })
    make("TextLabel", {
        Text = name,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 1, 0),
        Parent = namePill,
    })

    attachHover(keyPill, 0.15)

    keyPill.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        keyLabel.Text = "..."
        tween(keyPill.UIStroke, { Color = Theme.Accent, Transparency = 0.1 }, EASE_FAST)

        local conn
        conn = UserInputService.InputBegan:Connect(function(input, gpe)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            conn:Disconnect()
            keyCode = input.KeyCode
            keyLabel.Text = keyCode.Name
            listening = false
            tween(keyPill.UIStroke, { Color = Theme.Stroke, Transparency = 0.6 }, EASE_FAST)
            tween(keyPill, { Size = keyPill.Size }, EASE_POP) -- little pop confirm
            if onRebind then onRebind(keyCode) end
        end)
    end)

    return row
end

-- ============================================================
-- WINDOW / TAB / SECTION
-- ============================================================
function GlassUI:CreateWindow(config)
    config = config or {}
    local windowName = config.Name or "GlassUI"
    if config.Accent then Theme.Accent = config.Accent end
    local size = config.Size or UDim2.new(0, 560, 0, 380)

    local Window = {}
    Window.Tabs = {}

    local Main = make("Frame", {
        Name = "Main",
        Size = UDim2.new(0, size.X.Offset, 0, size.Y.Offset),
        Position = UDim2.new(0.5, -size.X.Offset / 2, 0.5, -size.Y.Offset / 2),
        Parent = ScreenGui,
    })
    applyGlass(Main, 16, Theme.Background, 0.05)
    Main.ClipsDescendants = true

    -- pop-in on load
    Main.Size = UDim2.new(0, size.X.Offset, 0, 0)
    tween(Main, { Size = size }, EASE_POP)

    local TopBar = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), Parent = Main })
    make("Frame", {
        BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, 0), Parent = TopBar,
    })
    make("TextLabel", {
        Text = windowName, Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 0), Size = UDim2.new(1, -80, 1, 0), Parent = TopBar,
    })

    local closeBtn = make("TextButton", {
        Text = "✕", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Theme.SubText,
        BackgroundTransparency = 1, Size = UDim2.new(0, 32, 0, 32), Position = UDim2.new(1, -40, 0, 7),
        Parent = TopBar,
    })
    closeBtn.MouseEnter:Connect(function() tween(closeBtn, { TextColor3 = Theme.Error }, EASE_FAST) end)
    closeBtn.MouseLeave:Connect(function() tween(closeBtn, { TextColor3 = Theme.SubText }, EASE_FAST) end)
    closeBtn.MouseButton1Click:Connect(function()
        local t = tween(Main, { Size = UDim2.new(0, size.X.Offset, 0, 0) }, EASE_SMOOTH)
        t.Completed:Wait()
        ScreenGui.Enabled = false
    end)

    local minBtn = make("TextButton", {
        Text = "—", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Theme.SubText,
        BackgroundTransparency = 1, Size = UDim2.new(0, 32, 0, 32), Position = UDim2.new(1, -72, 0, 7),
        Parent = TopBar,
    })
    attachHover(minBtn, 1)
    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            tween(Main, { Size = UDim2.new(0, size.X.Offset, 0, 46) }, EASE_SMOOTH)
        else
            tween(Main, { Size = size }, EASE_POP)
        end
    end)

    makeDraggable(TopBar, Main)

    local TabBar = make("Frame", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 46), Size = UDim2.new(0, 140, 1, -46),
        Parent = Main,
    })
    make("Frame", {
        BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.7, BorderSizePixel = 0,
        Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, 0, 0, 0), Parent = TabBar,
    })
    local TabList = make("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, -10, 1, -10), Position = UDim2.new(0, 5, 0, 5),
        Parent = TabBar,
    })
    make("UIListLayout", { Padding = UDim.new(0, 4), Parent = TabList })

    local ContentArea = make("Frame", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 140, 0, 46), Size = UDim2.new(1, -140, 1, -46),
        Parent = Main,
    })

    function Window:CreateTab(name)
        local Tab = {}

        local tabBtn = make("TextButton", {
            Text = "  " .. name, Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = Theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 0.4, BackgroundColor3 = Theme.Glass,
            Size = UDim2.new(1, 0, 0, 32), Parent = TabList,
        })
        make("UICorner", { CornerRadius = UDim.new(0, 8), Parent = tabBtn })

        local Page = make("ScrollingFrame", {
            BackgroundTransparency = 1, Size = UDim2.new(1, -10, 1, -10), Position = UDim2.new(0, 5, 0, 5),
            CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent, Visible = false, Parent = ContentArea,
        })
        make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = Page })

        local isFirst = (#Window.Tabs == 0)
        Page.Visible = isFirst
        tabBtn.BackgroundTransparency = isFirst and 0.1 or 1
        tabBtn.TextColor3 = isFirst and Theme.Text or Theme.SubText

        tabBtn.MouseButton1Click:Connect(function()
            for _, t in ipairs(Window.Tabs) do
                t.Page.Visible = false
                tween(t.Button, { BackgroundTransparency = 1, TextColor3 = Theme.SubText }, EASE_FAST)
            end
            Page.Visible = true
            tween(tabBtn, { BackgroundTransparency = 0.1, TextColor3 = Theme.Text }, EASE_FAST)
        end)

        table.insert(Window.Tabs, { Page = Page, Button = tabBtn })

        function Tab:CreateSection(name)
            local Section = {}

            local SecFrame = make("Frame", {
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, Parent = Page,
            })
            make("TextLabel", {
                Text = name, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.SubText,
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20),
                TextXAlignment = Enum.TextXAlignment.Left, Parent = SecFrame,
            })
            local Holder = make("Frame", {
                BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 22),
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = SecFrame,
            })
            make("UIListLayout", { Padding = UDim.new(0, 6), Parent = Holder })

            local function baseCard(height)
                local card = make("Frame", { Size = UDim2.new(1, 0, 0, height or 34), Parent = Holder })
                applyGlass(card, 8, Theme.Glass, 0.35)
                return card
            end

            function Section:CreateButton(cfg)
                cfg = cfg or {}
                local card = baseCard(34)
                local btn = make("TextButton", {
                    Text = cfg.Name or "Button", Font = Enum.Font.GothamMedium, TextSize = 13,
                    TextColor3 = Theme.Text, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                    Parent = card,
                })
                attachHover(card, 0.35)
                btn.MouseButton1Click:Connect(function()
                    tween(card, { BackgroundTransparency = 0.05 }, EASE_FAST)
                    task.wait(0.1)
                    tween(card, { BackgroundTransparency = 0.35 }, EASE_SMOOTH)
                    if cfg.Callback then cfg.Callback() end
                end)
                return btn
            end

            function Section:CreateToggle(cfg)
                cfg = cfg or {}
                local state = cfg.Default or false
                local boundKey = cfg.Keybind
                local card = baseCard(34)

                make("TextLabel", {
                    Text = cfg.Name or "Toggle", Font = Enum.Font.GothamMedium, TextSize = 13,
                    TextColor3 = Theme.Text, BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0, 0),
                    Size = UDim2.new(1, -60, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
                })

                local switch = make("Frame", {
                    BackgroundColor3 = state and Theme.Accent or Theme.GlassLight,
                    Position = UDim2.new(1, -42, 0.5, -9), Size = UDim2.new(0, 32, 0, 18), Parent = card,
                })
                make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = switch })
                local knob = make("Frame", {
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                    Size = UDim2.new(0, 14, 0, 14), Parent = switch,
                })
                make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

                local click = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = card })

                local function set(newState)
                    state = newState
                    tween(switch, { BackgroundColor3 = state and Theme.Accent or Theme.GlassLight }, EASE_SMOOTH)
                    tween(knob, { Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7) }, EASE_POP)
                    if cfg.Flag then GlassUI.Flags[cfg.Flag] = state end
                    if cfg.Callback then cfg.Callback(state) end
                end

                click.MouseButton1Click:Connect(function() set(not state) end)

                if boundKey then
                    GlassUI:AddKeybindEntry(cfg.Name, boundKey, function(newKey)
                        boundKey = newKey
                    end)
                    UserInputService.InputBegan:Connect(function(input, gpe)
                        if gpe then return end
                        if input.KeyCode == boundKey then set(not state) end
                    end)
                end

                if cfg.Default then set(true) end
                return { Set = set }
            end

            function Section:CreateSlider(cfg)
                cfg = cfg or {}
                local min, max = cfg.Min or 0, cfg.Max or 100
                local value = cfg.Default or min
                local card = baseCard(44)

                local label = make("TextLabel", {
                    Text = (cfg.Name or "Slider") .. ": " .. tostring(value), Font = Enum.Font.GothamMedium,
                    TextSize = 13, TextColor3 = Theme.Text, BackgroundTransparency = 1,
                    Position = UDim2.new(0, 12, 0, 4), Size = UDim2.new(1, -24, 0, 16),
                    TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
                })

                local track = make("Frame", {
                    BackgroundColor3 = Theme.GlassLight, Position = UDim2.new(0, 12, 0, 28),
                    Size = UDim2.new(1, -24, 0, 6), Parent = card,
                })
                make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
                local fill = make("Frame", {
                    BackgroundColor3 = Theme.Accent, Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                    Parent = track,
                })
                make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })

                local dragging = false
                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        value = math.floor(min + (max - min) * rel)
                        tween(fill, { Size = UDim2.new(rel, 0, 1, 0) }, EASE_FAST)
                        label.Text = (cfg.Name or "Slider") .. ": " .. tostring(value)
                        if cfg.Flag then GlassUI.Flags[cfg.Flag] = value end
                        if cfg.Callback then cfg.Callback(value) end
                    end
                end)

                return { Set = function(v) value = v end }
            end

            function Section:CreateDropdown(cfg)
                cfg = cfg or {}
                local options = cfg.Options or {}
                local selected = cfg.Default or options[1]
                local open = false
                local card = baseCard(34)
                card.ClipsDescendants = true

                make("TextLabel", {
                    Text = cfg.Name or "Dropdown", Font = Enum.Font.GothamMedium, TextSize = 13,
                    TextColor3 = Theme.Text, BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0, 0),
                    Size = UDim2.new(0.5, 0, 0, 34), TextXAlignment = Enum.TextXAlignment.Left, Parent = card,
                })
                local valueLabel = make("TextLabel", {
                    Text = tostring(selected) .. " ▾", Font = Enum.Font.GothamMedium, TextSize = 13,
                    TextColor3 = Theme.Accent, BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0, 0),
                    Size = UDim2.new(0.5, -12, 0, 34), TextXAlignment = Enum.TextXAlignment.Right, Parent = card,
                })
                local optList = make("Frame", {
                    BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 36),
                    Size = UDim2.new(1, 0, 0, #options * 26), Parent = card,
                })
                make("UIListLayout", { Padding = UDim.new(0, 2), Parent = optList })

                for _, opt in ipairs(options) do
                    local optBtn = make("TextButton", {
                        Text = tostring(opt), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.SubText,
                        BackgroundTransparency = 1, Size = UDim2.new(1, -12, 0, 24), Position = UDim2.new(0, 12, 0, 0),
                        TextXAlignment = Enum.TextXAlignment.Left, Parent = optList,
                    })
                    optBtn.MouseEnter:Connect(function() tween(optBtn, { TextColor3 = Theme.Text }, EASE_FAST) end)
                    optBtn.MouseLeave:Connect(function() tween(optBtn, { TextColor3 = Theme.SubText }, EASE_FAST) end)
                    optBtn.MouseButton1Click:Connect(function()
                        selected = opt
                        valueLabel.Text = tostring(selected) .. " ▾"
                        if cfg.Flag then GlassUI.Flags[cfg.Flag] = selected end
                        if cfg.Callback then cfg.Callback(selected) end
                        open = false
                        tween(card, { Size = UDim2.new(1, 0, 0, 34) }, EASE_SMOOTH)
                    end)
                end

                local click = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), ZIndex = 2, Parent = card })
                click.MouseButton1Click:Connect(function()
                    open = not open
                    if open then
                        tween(card, { Size = UDim2.new(1, 0, 0, 36 + #options * 26) }, EASE_POP)
                    else
                        tween(card, { Size = UDim2.new(1, 0, 0, 34) }, EASE_SMOOTH)
                    end
                end)

                return { Set = function(v) selected = v; valueLabel.Text = tostring(v) .. " ▾" end }
            end

            return Section
        end

        return Tab
    end

    return Window
end

return GlassUI
