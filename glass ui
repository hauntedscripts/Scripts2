local GlassUI = {}
GlassUI.Flags = {}

local ScreenGui = make("ScreenGui", {
    Name = "GlassUI",
    ResetOnSpawn = false,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    Parent = (gethui and gethui()) or CoreGui,
