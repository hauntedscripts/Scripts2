-- ============================================================
-- NOTE ON BLUR:
-- Roblox's ScreenGui is a flat 2D overlay with no "backdrop-filter"
-- equivalent, and BlurEffect only lives on Lighting, which blurs the
-- ENTIRE 3D viewport rather than just what's behind one frame. There's
-- no supported way to selectively blur only the pixels behind a
-- specific UI panel. So instead of a real (whole-screen) blur, the
-- panels below fake the "frosted glass" look using layered
-- transparency, a soft stroke, and a faint gradient sheen - this only
-- affects the UI itself and never touches the rest of the screen.
-- ============================================================
-- NOTIFICATIONS
-- ============================================================
local NotifHolder = make("Frame", {
    Name = "Notifications",
    BackgroundTransparency = 1,
    AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, -20, 0, 20),
    Size = UDim2.new(0, 300, 1, -40),
    Parent = ScreenGui,
})
make("UIListLayout", {
    Padding = UDim.new(0, 10),
    HorizontalAlignment = Enum.HorizontalAlignment.Right,
    SortOrder = Enum.SortOrder.LayoutOrder,
    Parent = NotifHolder,
})

function GlassUI:Notify(config)
    config = config or {}
    local title = config.Title or "Notification"
    local content = config.Content or ""
    local duration = config.Duration or 4
    local ntype = config.Type or "Info"

    local color = Theme.Accent
    if ntype == "Success" then color = Theme.Success
    elseif ntype == "Error" then color = Theme.Error
    elseif ntype == "Warning" then color = Theme.Warning end

    local card = make("Frame", {
        BackgroundColor3 = Theme.Glass,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        ClipsDescendants = true,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1.4, 0, 0, 0),
        Parent = NotifHolder,
    })
    applyGlass(card, 10, Theme.Glass, 1) -- start fully transparent, fade in
    card.UIGradient:Destroy()

    make("Frame", {
        BackgroundColor3 = color,
        Size = UDim2.new(0, 4, 1, 0),
        BorderSizePixel = 0,
        Parent = card,
    })
    make("UIPadding", {
        PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 12),
        Parent = card,
    })
    local titleLbl = make("TextLabel", {
        Text = title, Font = Enum.Font.GothamBold, TextSize = 14,
        TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1, TextTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18), Parent = card,
    })
    local contentLbl = make("TextLabel", {
        Text = content, Font = Enum.Font.Gotham, TextSize = 12,
        TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true, BackgroundTransparency = 1, TextTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(0, 0, 0, 20), Parent = card,
    })

    tween(card, { Position = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 0.15 }, EASE_POP)
    tween(titleLbl, { TextTransparency = 0 }, EASE_SMOOTH)
    tween(contentLbl, { TextTransparency = 0 }, EASE_SMOOTH)

    task.delay(duration, function()
        tween(titleLbl, { TextTransparency = 1 }, EASE_FAST)
        tween(contentLbl, { TextTransparency = 1 }, EASE_FAST)
        local t = tween(card, { Position = UDim2.new(1.4, 0, 0, 0), BackgroundTransparency = 1 }, EASE_SMOOTH)
        t.Completed:Wait()
        card:Destroy()
    end)
end

