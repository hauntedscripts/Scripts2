--[[
    GlassUI v2 - A glassmorphism-style UI library for Roblox
    Features: Windows, Tabs, Sections, Buttons, Toggles, Sliders,
              Dropdowns, click-to-rebind Keybinds, a pill-style
              Keybind List panel, real background blur, spring
              animations, and a Notification system.

    USAGE:
        local GlassUI = loadstring(game:HttpGet("PATH_TO_THIS_FILE"))()

        local Window = GlassUI:CreateWindow({
            Name = "My Script Hub",
            Accent = Color3.fromRGB(150, 120, 255),
        })

        local Tab = Window:CreateTab("Main")
        local Section = Tab:CreateSection("Combat")

        Section:CreateToggle({
            Name = "Auto Farm",
            Default = false,
            Keybind = Enum.KeyCode.F, -- shows in keybind list, click to rebind
            Callback = function(state) print("Auto Farm:", state) end
        })

        GlassUI:Notify({
            Title = "Loaded",
            Content = "GlassUI has loaded successfully.",
            Duration = 4,
        })
]]

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local Lighting = game:GetService("Lighting")

-- Clean up any BlurEffect left behind by a previous run of this script.
-- (Lighting persists across script re-executions in the same session,
-- so an old blur from an earlier version would otherwise stay stuck on.)
for _, fx in ipairs(Lighting:GetChildren()) do
    if fx:IsA("BlurEffect") then
        fx:Destroy()
    end
end

-- ============================================================
-- THEME
-- ============================================================
local Theme = {
    Background = Color3.fromRGB(20, 20, 26),
    Glass      = Color3.fromRGB(32, 32, 42),
    GlassLight = Color3.fromRGB(48, 48, 62),
    Pill       = Color3.fromRGB(40, 40, 52),
    Stroke     = Color3.fromRGB(95, 95, 125),
    Text       = Color3.fromRGB(238, 238, 248),
    SubText    = Color3.fromRGB(165, 165, 185),
    Accent     = Color3.fromRGB(150, 120, 255),
    Success    = Color3.fromRGB(95, 220, 145),
    Error      = Color3.fromRGB(240, 95, 95),
    Warning    = Color3.fromRGB(240, 190, 95),
}

-- Easing presets for consistent "spring" feel
local EASE_POP    = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local EASE_SMOOTH = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local EASE_FAST   = TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

local function tween(obj, props, info)
    local t = TweenService:Create(obj, info or EASE_SMOOTH, props)
    t:Play()
    return t
end

local function make(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    for _, c in ipairs(children or {}) do
        c.Parent = inst
    end
    return inst
end

-- Glass fill: translucent color + soft border + faint sheen gradient
local function applyGlass(frame, cornerRadius, fillColor, transparency)
    frame.BackgroundColor3 = fillColor or Theme.Glass
    frame.BackgroundTransparency = transparency or 0.25
    frame.BorderSizePixel = 0

    make("UICorner", { CornerRadius = UDim.new(0, cornerRadius or 12), Parent = frame })
    make("UIStroke", {
        Color = Theme.Stroke, Thickness = 1, Transparency = 0.55, Parent = frame,
    })
    make("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 200, 210)),
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.88),
            NumberSequenceKeypoint.new(1, 0.97),
        }),
        Rotation = 90,
        Parent = frame,
    })
    return frame
end

-- Fully rounded pill (corner radius = half height, since UICorner uses scale it's simplest as 1,0)
local function applyPill(frame, fillColor, transparency)
    frame.BackgroundColor3 = fillColor or Theme.Pill
    frame.BackgroundTransparency = transparency or 0.15
    frame.BorderSizePixel = 0
    make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = frame })
    make("UIStroke", { Color = Theme.Stroke, Thickness = 1, Transparency = 0.6, Parent = frame })
    return frame
end

-- Hover/press "pop" helper: subtle scale + brighten on hover
local function attachHover(button, baseTransparency)
    button.MouseEnter:Connect(function()
        tween(button, { BackgroundTransparency = math.max(baseTransparency - 0.12, 0) }, EASE_FAST)
    end)
    button.MouseLeave:Connect(function()
        tween(button, { BackgroundTransparency = baseTransparency }, EASE_FAST)
    end)
end

local function makeDraggable(handle, target)
    local dragging, dragInput, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

