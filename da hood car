            local char = localPlayer.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local v = hrp.AssemblyLinearVelocity
                speed = math.sqrt(v.X*v.X + v.Z*v.Z + v.Y*v.Y)
            end
        end
        speedoLabel.Text    = string.format("%.0f studs/s", speed)
        speedoLabel.Visible = true
    end
end)

