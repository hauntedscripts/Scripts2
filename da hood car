local bhopConn = nil
local bhopVelocity         = Vector3.zero
local bhopMoveF, bhopMoveR = 0, 0
local bhopJumpHeld         = false
local bhopChar, bhopHum, bhopRoot
local storedAnimateScript  = nil

local function bhopFlat(v) return Vector3.new(v.X, 0, v.Z) end

local function srcAccelerate(vel, wishDir, wishSpeed, accel, dt)
    local addSpeed = wishSpeed - vel:Dot(wishDir)
    if addSpeed <= 0 then return vel end
    local accelSpeed = math.min(accel * wishSpeed * dt, addSpeed)
    return vel + wishDir * accelSpeed
end

local function srcFriction(vel, dt)
    local speed = bhopFlat(vel).Magnitude
    if speed < 0.1 then return Vector3.new(0, vel.Y, 0) end
    local drop  = math.max(speed, bhopGroundSpeed) * bhopFriction * dt
    local scale = math.max(speed - drop, 0) / speed
    return Vector3.new(vel.X * scale, vel.Y, vel.Z * scale)
end

local function nukeAnims(char)
    if not bhopDisableAnims then return end
    local anim = char:FindFirstChild("Animate")
    if anim then
        storedAnimateScript = anim:Clone()
        anim:Destroy()
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _, t in hum:GetPlayingAnimationTracks() do t:Stop(0) end
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then animator:Destroy() end
    end
end

local function restoreAnims(char)
    if not char then return end
    if storedAnimateScript then
        local existing = char:FindFirstChild("Animate")
        if existing then existing:Destroy() end
        local clone = storedAnimateScript:Clone()
        clone.Parent = char
        storedAnimateScript = nil
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and not hum:FindFirstChildOfClass("Animator") then
        Instance.new("Animator").Parent = hum
    end
end

local function bhopGetWishDir()
    if bhopMoveF == 0 and bhopMoveR == 0 then return Vector3.zero end
    local cf  = workspace.CurrentCamera.CFrame
    local dir = bhopFlat(cf.LookVector).Unit * bhopMoveF
              + bhopFlat(cf.RightVector).Unit * bhopMoveR
    return dir.Magnitude > 0 and dir.Unit or Vector3.zero
end

local bhopRayParams = RaycastParams.new()
bhopRayParams.FilterType = Enum.RaycastFilterType.Exclude

local function bhopGrounded()
    if not bhopRoot or not bhopChar then return false end
    bhopRayParams.FilterDescendantsInstances = {bhopChar}
    return workspace:Raycast(bhopRoot.Position, Vector3.new(0, -3.5, 0), bhopRayParams) ~= nil
end

local function bhopSetup(char)
    bhopChar      = char
    bhopHum       = char:WaitForChild("Humanoid")
    bhopRoot      = char:WaitForChild("HumanoidRootPart")
    bhopVelocity  = Vector3.zero
    bhopMoveF, bhopMoveR = 0, 0
    bhopJumpHeld  = false

    task.wait()
    if not playerBhopEnabled then return end

    workspace.Gravity = 196.2

    localPlayer.CameraMode = bhopFirstPerson
        and Enum.CameraMode.LockFirstPerson
        or  Enum.CameraMode.Classic

    bhopHum.WalkSpeed  = 0
    bhopHum.JumpPower  = 0
    bhopHum.JumpHeight = 0
    bhopHum.AutoRotate = false
    bhopHum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    nukeAnims(char)

    bhopHum.StateChanged:Connect(function()
        if not playerBhopEnabled then return end
        bhopHum.WalkSpeed  = 0
        bhopHum.JumpPower  = 0
        bhopHum.JumpHeight = 0
        bhopHum.AutoRotate = false
        bhopHum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    end)

    if bhopConn then bhopConn:Disconnect() end
    bhopConn = RunService.RenderStepped:Connect(function(dt)
        if not playerBhopEnabled then return end
        if not bhopRoot or not bhopHum or bhopHum.Health <= 0 then return end

        bhopHum.WalkSpeed  = 0
        bhopHum.JumpPower  = 0
        bhopHum.JumpHeight = 0
        bhopHum.AutoRotate = false

        local grounded = bhopGrounded()
        bhopVelocity = Vector3.new(
            bhopVelocity.X,
            bhopRoot.AssemblyLinearVelocity.Y,
            bhopVelocity.Z
        )

        local shouldJump = bhopJumpHeld or autoBhopEnabled
        if grounded and shouldJump then
            bhopVelocity = Vector3.new(bhopVelocity.X, bhopJumpPower, bhopVelocity.Z)
            grounded = false
        end

        local wishDir = bhopGetWishDir()

        if grounded then
            bhopVelocity = srcFriction(bhopVelocity, dt)
            if wishDir.Magnitude > 0 then
                bhopVelocity = srcAccelerate(bhopVelocity, wishDir,
                    bhopGroundSpeed, bhopGroundAccel, dt)
            end
        elseif wishDir.Magnitude > 0 then
            bhopVelocity = srcAccelerate(bhopVelocity, wishDir,
                bhopAirSpeed, bhopAirAccel, dt)
        end

        local fv = bhopFlat(bhopVelocity)
        if fv.Magnitude > bhopMaxSpeed then
            fv = fv.Unit * bhopMaxSpeed
            bhopVelocity = Vector3.new(fv.X, bhopVelocity.Y, fv.Z)
        end

        bhopRoot.AssemblyLinearVelocity = bhopVelocity

        local look = bhopFlat(workspace.CurrentCamera.CFrame.LookVector)
        if look.Magnitude > 0.01 then
            bhopRoot.CFrame = CFrame.new(bhopRoot.Position, bhopRoot.Position + look)
        end
    end)
end

local function bhopDisable()
    playerBhopEnabled = false
    if bhopConn then bhopConn:Disconnect(); bhopConn = nil end
    if bhopHum then
        bhopHum.WalkSpeed  = 16
        bhopHum.JumpPower  = 50
        bhopHum.JumpHeight = 7.2
        bhopHum.AutoRotate = true
        bhopHum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
    end
    restoreAnims(bhopChar)
    localPlayer.CameraMode = Enum.CameraMode.Classic
    bhopMoveF, bhopMoveR   = 0, 0
    bhopJumpHeld           = false
    bhopVelocity           = Vector3.zero
end

UIS.InputBegan:Connect(function(inp, gp)
    local kc = inp.KeyCode
    if kc == Enum.KeyCode.Space then bhopJumpHeld = true; return end
    if gp or not playerBhopEnabled then return end
    if     kc == Enum.KeyCode.W then bhopMoveF =  1
    elseif kc == Enum.KeyCode.S then bhopMoveF = -1
    elseif kc == Enum.KeyCode.A then bhopMoveR = -1
    elseif kc == Enum.KeyCode.D then bhopMoveR =  1 end
end)

UIS.InputEnded:Connect(function(inp)
    local kc = inp.KeyCode
    if kc == Enum.KeyCode.Space                     then bhopJumpHeld = false
    elseif kc == Enum.KeyCode.W and bhopMoveF ==  1 then bhopMoveF = 0
    elseif kc == Enum.KeyCode.S and bhopMoveF == -1 then bhopMoveF = 0
    elseif kc == Enum.KeyCode.A and bhopMoveR == -1 then bhopMoveR = 0
    elseif kc == Enum.KeyCode.D and bhopMoveR ==  1 then bhopMoveR = 0 end
end)

