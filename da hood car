    end
end)

game.Workspace:GetPropertyChangedSignal("Gravity"):Connect(function()
    if gravityEnabled then game.Workspace.Gravity = gravityStrength end
end)

RunService.Heartbeat:Connect(function()
    if gravityEnabled then game.Workspace.Gravity = gravityStrength end

    local car = getMyDrivenCar()

    if noFlipEnabled then
        wasNoFlip = true
        if car then
            local bav = car:FindFirstChild("BodyAngularVelocity")
            if bav then
                bav.MaxTorque       = Vector3.new(1e9, 0, 1e9)
                bav.AngularVelocity = Vector3.new(0, bav.AngularVelocity.Y, 0)
            end
        end
    elseif wasNoFlip then
        wasNoFlip = false
        if car then
            local bav = car:FindFirstChild("BodyAngularVelocity")
            if bav then bav.MaxTorque = Vector3.new(0, bav.MaxTorque.Y, 0) end
        end
    end

    if spinEnabled then
        wasSpin = true
        if car then
            local bav = car:FindFirstChild("BodyAngularVelocity")
            if bav then
                bav.MaxTorque       = Vector3.new(bav.MaxTorque.X, 1e9, bav.MaxTorque.Z)
                bav.AngularVelocity = Vector3.new(0, spinSpeed, 0)
            end
        end
    elseif wasSpin then
        wasSpin = false
        if car then
            local bav = car:FindFirstChild("BodyAngularVelocity")
            if bav then
                bav.MaxTorque       = Vector3.new(bav.MaxTorque.X, 0, bav.MaxTorque.Z)
                bav.AngularVelocity = Vector3.new(0, 0, 0)
            end
        end
    end

    if freezeEnabled and car then
        if not frozenCFrame then frozenCFrame = car.CFrame end
        local mp = getMainPart(car)
        if mp then
            mp.AssemblyLinearVelocity  = Vector3.new(0, 0, 0)
            mp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        car.CFrame = frozenCFrame
    end

    if speedLimitEnabled and car then
        local mp = getMainPart(car)
        if mp then
            local vel = mp.AssemblyLinearVelocity
            local hv  = Vector3.new(vel.X, 0, vel.Z)
            if hv.Magnitude > speedLimitValue then
                local clamped = hv.Unit * speedLimitValue
                mp.AssemblyLinearVelocity = Vector3.new(clamped.X, vel.Y, clamped.Z)
            end
        end
    end

    if not floatEnabled or not car then return end
    if not floatY then floatY = car.Position.Y end
    local bv = car:FindFirstChild("BodyVelocity")
    if bv then
        bv.MaxForce = Vector3.new(bv.MaxForce.X, 1e9, bv.MaxForce.Z)
        bv.Velocity = Vector3.new(bv.Velocity.X, 0, bv.Velocity.Z)
    end
    local cf = car.CFrame
    car.CFrame = CFrame.new(cf.Position.X, floatY, cf.Position.Z) * (cf - cf.Position)
end)

task.spawn(function()
    while true do
        task.wait(boostInterval)
        if not boostEnabled then continue end
        local drivenCar = getMyDrivenCar()
        if drivenCar ~= boostedCar then
            cleanup()
            if drivenCar then setupBoost(drivenCar) end
        end
        if boostedCar and currentVectorForce then
            local mp = getMainPart(boostedCar)
            if mp then
                local vel = mp.AssemblyLinearVelocity
                local fv  = Vector3.new(vel.X, 0, vel.Z)
                currentVectorForce.Force = fv.Magnitude > 0.5
                    and fv.Unit * mp.AssemblyMass * boostForce
                    or  Vector3.new(0, 0, 0)
            end
        end
    end
end)

end
