local function getMainPart(vehicle)
    if vehicle:IsA("BasePart") then return vehicle end
    for _, part in ipairs(vehicle:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then return part end
    end
end

local function getMyDrivenCar()
    for _, vehicle in ipairs(vehiclesFolder:GetChildren()) do
        local driver = vehicle:FindFirstChild("Driver")
        if driver and driver:IsA("ObjectValue") then
            local playerChar = game.Workspace.Players:FindFirstChild(localPlayer.Name)
            if driver.Value == playerChar then return vehicle end
        end
    end
    return nil
end

local function cleanup()
    if currentVectorForce then currentVectorForce:Destroy(); currentVectorForce = nil end
    if currentAttachment  then currentAttachment:Destroy();  currentAttachment  = nil end
    boostedCar = nil
end

local function setupBoost(vehicle)
    local mp = getMainPart(vehicle); if not mp then return false end
    local att = Instance.new("Attachment"); att.Name = "BoostAttachment"; att.Parent = mp
    local vf  = Instance.new("VectorForce")
    vf.Name = "BoostForce"; vf.Attachment0 = att
    vf.RelativeTo = Enum.ActuatorRelativeTo.World
    vf.Force = Vector3.new(0, 0, 0); vf.Parent = att
    currentAttachment = att; currentVectorForce = vf; boostedCar = vehicle
    return true
end

local function getCarList()
    local cars = {}
    for _, v in ipairs(vehiclesFolder:GetChildren()) do cars[#cars + 1] = v.Name end
    if #cars == 0 then cars[#cars + 1] = "No cars" end
    return cars
end

local function startBounceLoop()
    task.spawn(function()
        while bounceEnabled do
            local car = getMyDrivenCar()
            if car then
                car.AssemblyLinearVelocity = Vector3.new(
                    car.AssemblyLinearVelocity.X, bounceForce, car.AssemblyLinearVelocity.Z)
            end
            task.wait(1.5)
        end
    end)
end

